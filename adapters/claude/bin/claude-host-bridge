#!/usr/bin/env bash
set -euo pipefail

# Claude Code host bridge for agent-crew native handoffs.
#
# Run Claude from an isolated cwd so project-level CLAUDE.md / hooks do not
# reinterpret a handoff validation as a new crew:run request. The task and
# project roots are still explicitly available through --add-dir.

fail() {
  printf 'claude-host-bridge: %s\n' "$*" >&2
  exit 2
}

require_env() {
  local name="$1"
  local value="${!name:-}"
  [ -n "${value}" ] || fail "missing required environment variable: ${name}"
}

require_env AGENT_CREW_TASK_ID
require_env AGENT_CREW_TASK_DIR
require_env AGENT_CREW_HANDOFF_PATH
require_env AGENT_CREW_RESULT_PATH
require_env AGENT_CREW_PROJECT_ROOT

if [ "${AGENT_CREW_HOST_BRIDGE_ACTIVE:-0}" = "1" ]; then
  fail "refusing recursive host bridge invocation"
fi

CLAUDE_BIN="${AGENT_CREW_CLAUDE_BIN:-claude}"
if ! command -v "${CLAUDE_BIN}" >/dev/null 2>&1; then
  printf 'claude-host-bridge: Claude executable not found: %s\n' "${CLAUDE_BIN}" >&2
  exit 127
fi

TASK_ID="${AGENT_CREW_TASK_ID}"
TASK_DIR="${AGENT_CREW_TASK_DIR}"
HANDOFF_PATH="${AGENT_CREW_HANDOFF_PATH}"
RESULT_PATH="${AGENT_CREW_RESULT_PATH}"
PROJECT_ROOT="${AGENT_CREW_PROJECT_ROOT}"
CONTEXT_DIR="${TASK_DIR}/context"
mkdir -p "${CONTEXT_DIR}"

PROMPT_PATH="${CONTEXT_DIR}/claude-host-bridge-prompt.md"
LAST_MESSAGE_PATH="${CONTEXT_DIR}/claude-host-bridge-last-message.json"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

handoff_has_normalization_gate() {
  grep -Eq '^[[:space:]]*NORMALIZATION_GATE:[[:space:]]*required[[:space:]]*$' "${HANDOFF_PATH}" 2>/dev/null
}

resolve_token_usage_script() {
  local root
  local home_root="${AGENT_CREW_HOME:-${HOME}/.agent-crew}"
  if [ -n "${AGENT_CREW_TOKEN_USAGE_SCRIPT:-}" ] && [ -f "${AGENT_CREW_TOKEN_USAGE_SCRIPT}" ]; then
    printf '%s\n' "${AGENT_CREW_TOKEN_USAGE_SCRIPT}"
    return 0
  fi
  for root in \
    "${home_root}/system/scripts" \
    "${home_root}/scripts" \
    "${SCRIPT_DIR}/../../../core/scripts" \
    "${SCRIPT_DIR}/../../../system/scripts"; do
    if [ -f "${root}/host-bridge-token-usage.py" ]; then
      printf '%s\n' "${root}/host-bridge-token-usage.py"
      return 0
    fi
  done
  return 1
}

record_token_usage() {
  local usage_script
  usage_script="$(resolve_token_usage_script 2>/dev/null || true)"
  [ -n "${usage_script}" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  python3 "${usage_script}" \
    --task-id "${TASK_ID}" \
    --task-dir "${TASK_DIR}" \
    --provider claude \
    --agent "${AGENT_CREW_AGENT_NAME:-host-bridge}" \
    --model "${MODEL:-unknown}" \
    --tier "${AGENT_CREW_CLAUDE_TIER:-unknown}" \
    --source "${LAST_MESSAGE_PATH}" \
    --format claude-json >/dev/null 2>&1 || true
}

APPEND_CURRENT_SESSION_FALLBACK=1

if [ -n "${AGENT_CREW_AGENT_REQUEST_ID:-}" ]; then
  cat > "${PROMPT_PATH}" <<EOF
Resume this existing agent-crew direct-agent handoff in Claude Code.

Do not create a new crew:run task. Do not invoke crew:run or any slash command. Read the existing handoff/request artifacts from the paths below, then complete or update the existing request state according to the installed agent-crew workflow.

If the handoff contains NORMALIZATION_MODE: inline_direct_bridge, perform the input-normalizer contract inline in this same bridge session, then continue as AGENT_CREW_AGENT_NAME. Do not spawn input-normalizer, korean-normalizer, a background agent, or a nested crew:agent/crew:run command for this normalization step.

Do not run crew repair for normal bridge completion. If the handoff completes successfully, exit 0 and let the parent agent-crew runtime record HOST_BRIDGE: auto_completed from the bridge process exit status. Use repair guidance only when the task is genuinely blocked, manually completed outside this bridge, or requires operator reconciliation after a failed bridge run.

AGENT_CREW_AGENT_NAME: ${AGENT_CREW_AGENT_NAME:-}
AGENT_CREW_AGENT_REQUEST_ID: ${AGENT_CREW_AGENT_REQUEST_ID}
AGENT_CREW_REQUEST_DIR: ${AGENT_CREW_REQUEST_DIR:-${TASK_DIR}}
AGENT_CREW_TASK_ID: ${TASK_ID}
AGENT_CREW_TASK_DIR: ${TASK_DIR}
AGENT_CREW_HANDOFF_PATH: ${HANDOFF_PATH}
AGENT_CREW_RESULT_PATH: ${RESULT_PATH}
AGENT_CREW_PROJECT_ROOT: ${PROJECT_ROOT}
EOF
elif handoff_has_normalization_gate; then
  APPEND_CURRENT_SESSION_FALLBACK=0
  cat > "${PROMPT_PATH}" <<EOF
Resume this existing agent-crew crew:run input-normalization handoff in Claude Code.

Complete only the input-normalizer contract described in the handoff. Do not continue to supervisor, do not invoke crew:run, and do not perform implementation, git, push, setup, or global update work.

Read AGENT_CREW_HANDOFF_PATH, return the requested normalization JSON/metadata, update only the existing task state files needed for the normalization gate when possible, and exit. If the task must continue beyond normalization, leave that for the parent runtime or current session after this bridge exits.

Do not run crew repair for normal bridge completion. If the handoff completes successfully, exit 0 and let the parent agent-crew runtime record HOST_BRIDGE: auto_completed from the bridge process exit status. Use repair guidance only when the task is genuinely blocked, manually completed outside this bridge, or requires operator reconciliation after a failed bridge run.

AGENT_CREW_TASK_ID: ${TASK_ID}
AGENT_CREW_TASK_DIR: ${TASK_DIR}
AGENT_CREW_HANDOFF_PATH: ${HANDOFF_PATH}
AGENT_CREW_RESULT_PATH: ${RESULT_PATH}
AGENT_CREW_PROJECT_ROOT: ${PROJECT_ROOT}
EOF
else
  cat > "${PROMPT_PATH}" <<EOF
Resume this existing agent-crew crew:run handoff in Claude Code.

Do not create a new crew:run task. Do not invoke crew:run or any slash command. Continue from the existing handoff artifacts below and complete or update the existing task state according to the installed agent-crew supervisor workflow.

Do not run crew repair for normal bridge completion. If the handoff completes successfully, exit 0 and let the parent agent-crew runtime record HOST_BRIDGE: auto_completed from the bridge process exit status. Use repair guidance only when the task is genuinely blocked, manually completed outside this bridge, or requires operator reconciliation after a failed bridge run.

AGENT_CREW_TASK_ID: ${TASK_ID}
AGENT_CREW_TASK_DIR: ${TASK_DIR}
AGENT_CREW_HANDOFF_PATH: ${HANDOFF_PATH}
AGENT_CREW_RESULT_PATH: ${RESULT_PATH}
AGENT_CREW_PROJECT_ROOT: ${PROJECT_ROOT}
EOF
fi

if [ "${APPEND_CURRENT_SESSION_FALLBACK}" = "1" ]; then
  cat >> "${PROMPT_PATH}" <<'EOF'

## Current-Session Fallback

If this handoff continues manually in the current Claude session, the current
session is only replacing the nested host bridge. It must not bypass
agent-crew dispatch, agent/user-agent/subagent selection, skill selection, TDD,
reviewer, QA, or repair evidence requirements.

Before executing task work, re-apply specialist selection for the normalized
task and record every selected axis in context/specialist-dispatch.md. Load
applicable skill files and record exact paths in context/skill-load.md or
context/skill-load.json.

For implementation or production-code mutation work, complete the full TDD
Red, Green, Refactor cycle before repair/completion. Before production-code
mutation, identify the focused test target, add or update the test, run it, and
record the expected failing result in context/tdd-red.md. If no runnable
harness or red failure can reasonably be produced, record the explicit
exception first in context/tdd-exception.md. After green, perform the refactor
review or document a no-op refactor decision, rerun focused verification, and
record it in context/tdd-refactor.md.

Use the provider-neutral command definitions under ~/.agent-crew/commands/.
Do not embed supervisor, planner, backend, frontend, resolver, or approval
behavior in this bridge prompt.
EOF
fi

SYSTEM_PROMPT="${AGENT_CREW_CLAUDE_BRIDGE_SYSTEM_PROMPT:-You are a minimal agent-crew host bridge executor. Follow only the provided handoff prompt. Do not invoke crew workflows unless the handoff explicitly requires it. Do not create a new task. Complete the existing handoff and exit.}"
MODEL="${AGENT_CREW_CLAUDE_MODEL:-claude-haiku-4-5}"
EFFORT="${AGENT_CREW_CLAUDE_EFFORT:-low}"
TOOLS="${AGENT_CREW_CLAUDE_TOOLS:-Bash}"
ALLOWED_TOOLS="${AGENT_CREW_CLAUDE_ALLOWED_TOOLS:-Bash}"
MAX_BUDGET="${AGENT_CREW_CLAUDE_MAX_BUDGET_USD:-}"
BRIDGE_MODE="${AGENT_CREW_CLAUDE_BRIDGE_MODE:-standard}"
if [ "${AGENT_CREW_CLAUDE_BARE:-0}" = "1" ]; then
  BRIDGE_MODE="bare"
fi

CLAUDE_ARGS=(
  --print
  --output-format json
  --model "${MODEL}"
  --effort "${EFFORT}"
  --no-session-persistence
  --disable-slash-commands
  --strict-mcp-config
  --mcp-config '{"mcpServers":{}}'
  --system-prompt "${SYSTEM_PROMPT}"
  --permission-mode dontAsk
  --tools "${TOOLS}"
  --allowedTools "${ALLOWED_TOOLS}"
  --add-dir "${PROJECT_ROOT}"
  --add-dir "${TASK_DIR}"
)

case "${BRIDGE_MODE}" in
  bare)
    CLAUDE_ARGS=(--bare "${CLAUDE_ARGS[@]}")
    ;;
  standard|minimal)
    CLAUDE_ARGS+=(--setting-sources user)
    ;;
  *)
    fail "invalid AGENT_CREW_CLAUDE_BRIDGE_MODE: ${BRIDGE_MODE}"
    ;;
esac

if [ -n "${MAX_BUDGET}" ]; then
  CLAUDE_ARGS+=(--max-budget-usd "${MAX_BUDGET}")
fi

BRIDGE_CWD="$(mktemp -d "${TMPDIR:-/tmp}/agent-crew-claude-bridge.XXXXXX")"
cleanup() {
  rm -rf "${BRIDGE_CWD}"
}
trap cleanup EXIT

printf 'claude-host-bridge: invoking Claude for task %s\n' "${TASK_ID}" >&2

set +e
AGENT_CREW_HOST_BRIDGE_ACTIVE=1 \
AGENT_CREW_AUTO_ROUTE_DISABLED=1 \
  bash -c 'cd "$1" && shift && exec "$@"' \
    bash "${BRIDGE_CWD}" "${CLAUDE_BIN}" "${CLAUDE_ARGS[@]}" "$(cat "${PROMPT_PATH}")" \
    > "${LAST_MESSAGE_PATH}"
CLAUDE_RC=$?
set -e

record_token_usage

if [ "${CLAUDE_RC}" -ne 0 ]; then
  exit "${CLAUDE_RC}"
fi

if ! grep -q '[^[:space:]]' "${LAST_MESSAGE_PATH}" 2>/dev/null; then
  printf 'AGENT_CREW_BRIDGE_STATUS: current_session_required\n' >&2
  printf 'claude-host-bridge: empty completion payload; current session must complete task %s\n' "${TASK_ID}" >&2
  exit 2
fi

cat "${LAST_MESSAGE_PATH}"
