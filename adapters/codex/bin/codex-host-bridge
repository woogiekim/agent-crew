#!/usr/bin/env bash
set -euo pipefail

# Codex host bridge for agent-crew native handoffs.
#
# The core runtime invokes this command through AGENT_CREW_HOST_BRIDGE_COMMAND
# after it has written deterministic handoff state. This adapter does not
# bypass agent-crew routing; it asks Codex to continue from the existing handoff
# paths and lets the normal crew:run / crew:agent instructions drive execution.

fail() {
  printf 'codex-host-bridge: %s\n' "$*" >&2
  exit 2
}

require_env() {
  local name="$1"
  local value="${!name:-}"
  [ -n "${value}" ] || fail "missing required environment variable: ${name}"
}

require_env AGENT_CREW_TASK_ID
require_env AGENT_CREW_TASK_DIR
require_env AGENT_CREW_HANDOFF_PATH
require_env AGENT_CREW_RESULT_PATH
require_env AGENT_CREW_PROJECT_ROOT

if [ "${AGENT_CREW_HOST_BRIDGE_ACTIVE:-0}" = "1" ]; then
  fail "refusing recursive host bridge invocation"
fi

running_under_codex() {
  local pid="${PPID:-}"
  local depth=0
  local args

  while [ -n "${pid}" ] && [ "${pid}" -gt 1 ] 2>/dev/null && [ "${depth}" -lt 25 ]; do
    args="$(ps -o args= -p "${pid}" 2>/dev/null || true)"
    if printf '%s\n' "${args}" | grep -Eq '(^|[ /])codex([[:space:]]|$)'; then
      return 0
    fi
    pid="$(ps -o ppid= -p "${pid}" 2>/dev/null | tr -d ' ' || true)"
    depth=$((depth + 1))
  done

  return 1
}

if [ "${AGENT_CREW_CODEX_ALLOW_NESTED:-0}" != "1" ] && running_under_codex; then
  printf 'AGENT_CREW_BRIDGE_STATUS: current_session_required\n' >&2
  fail "refusing nested Codex exec from an active Codex session; continue ${AGENT_CREW_HANDOFF_PATH} in the current host session or set AGENT_CREW_CODEX_ALLOW_NESTED=1 to override"
fi

CODEX_BIN="${AGENT_CREW_CODEX_BIN:-codex}"
if ! command -v "${CODEX_BIN}" >/dev/null 2>&1; then
  printf 'codex-host-bridge: Codex executable not found: %s\n' "${CODEX_BIN}" >&2
  exit 127
fi

TASK_ID="${AGENT_CREW_TASK_ID}"
TASK_DIR="${AGENT_CREW_TASK_DIR}"
HANDOFF_PATH="${AGENT_CREW_HANDOFF_PATH}"
RESULT_PATH="${AGENT_CREW_RESULT_PATH}"
PROJECT_ROOT="${AGENT_CREW_PROJECT_ROOT}"
CONTEXT_DIR="${TASK_DIR}/context"
mkdir -p "${CONTEXT_DIR}"

PROMPT_PATH="${CONTEXT_DIR}/codex-host-bridge-prompt.md"
LAST_MESSAGE_PATH="${CONTEXT_DIR}/codex-host-bridge-last-message.md"
STDOUT_LOG="${CONTEXT_DIR}/codex-host-bridge-stdout.log"
STDERR_LOG="${CONTEXT_DIR}/codex-host-bridge-stderr.log"
OUTPUT_LOG="${CONTEXT_DIR}/codex-host-bridge-output.log"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

resolve_token_usage_script() {
  local root
  local home_root="${AGENT_CREW_HOME:-${HOME}/.agent-crew}"
  if [ -n "${AGENT_CREW_TOKEN_USAGE_SCRIPT:-}" ] && [ -f "${AGENT_CREW_TOKEN_USAGE_SCRIPT}" ]; then
    printf '%s\n' "${AGENT_CREW_TOKEN_USAGE_SCRIPT}"
    return 0
  fi
  for root in \
    "${home_root}/system/scripts" \
    "${home_root}/scripts" \
    "${SCRIPT_DIR}/../../../core/scripts" \
    "${SCRIPT_DIR}/../../../system/scripts"; do
    if [ -f "${root}/host-bridge-token-usage.py" ]; then
      printf '%s\n' "${root}/host-bridge-token-usage.py"
      return 0
    fi
  done
  return 1
}

record_token_usage() {
  local usage_script
  usage_script="$(resolve_token_usage_script 2>/dev/null || true)"
  [ -n "${usage_script}" ] || return 0
  command -v python3 >/dev/null 2>&1 || return 0
  python3 "${usage_script}" \
    --task-id "${TASK_ID}" \
    --task-dir "${TASK_DIR}" \
    --provider codex \
    --agent "${AGENT_CREW_AGENT_NAME:-host-bridge}" \
    --model "${AGENT_CREW_CODEX_MODEL:-unknown}" \
    --tier "${AGENT_CREW_CODEX_TIER:-unknown}" \
    --source "${OUTPUT_LOG}" \
    --format codex-text >/dev/null 2>&1 || true
}

if [ -n "${AGENT_CREW_AGENT_REQUEST_ID:-}" ]; then
  cat > "${PROMPT_PATH}" <<EOF
Resume this existing agent-crew direct-agent handoff in Codex.

Do not create a new crew:run task. Preserve existing agent-crew ROUTE and crew:agent routing semantics. Read the handoff and request artifacts from the paths below, then complete or update the existing request state according to the installed agent-crew workflow.

Direct-agent bridges run with a read-only project sandbox. Return the final answer on stdout. If result.md cannot be written from the child process, the parent runtime will persist the bridge stdout as direct-agent result evidence.

Do not run crew repair for normal bridge completion. If the handoff completes successfully, exit 0 and let the parent agent-crew runtime record HOST_BRIDGE: auto_completed from the bridge process exit status. Use repair guidance only when the task is genuinely blocked, manually completed outside this bridge, or requires operator reconciliation after a failed bridge run.

AGENT_CREW_AGENT_NAME: ${AGENT_CREW_AGENT_NAME:-}
AGENT_CREW_AGENT_REQUEST_ID: ${AGENT_CREW_AGENT_REQUEST_ID}
AGENT_CREW_REQUEST_DIR: ${AGENT_CREW_REQUEST_DIR:-${TASK_DIR}}
AGENT_CREW_TASK_ID: ${TASK_ID}
AGENT_CREW_TASK_DIR: ${TASK_DIR}
AGENT_CREW_HANDOFF_PATH: ${HANDOFF_PATH}
AGENT_CREW_RESULT_PATH: ${RESULT_PATH}
AGENT_CREW_PROJECT_ROOT: ${PROJECT_ROOT}
EOF
else
  cat > "${PROMPT_PATH}" <<EOF
Resume this existing agent-crew crew:run handoff in Codex.

Do not create a new crew:run task. Preserve the installed agent-crew STOP behavior, command wrappers, and crew:run routing semantics. Continue from the existing handoff artifacts below and complete or update the existing task state according to the installed agent-crew supervisor workflow.

Do not run crew repair for normal bridge completion. If the handoff completes successfully, exit 0 and let the parent agent-crew runtime record HOST_BRIDGE: auto_completed from the bridge process exit status. Use repair guidance only when the task is genuinely blocked, manually completed outside this bridge, or requires operator reconciliation after a failed bridge run.

AGENT_CREW_TASK_ID: ${TASK_ID}
AGENT_CREW_TASK_DIR: ${TASK_DIR}
AGENT_CREW_HANDOFF_PATH: ${HANDOFF_PATH}
AGENT_CREW_RESULT_PATH: ${RESULT_PATH}
AGENT_CREW_PROJECT_ROOT: ${PROJECT_ROOT}
EOF
fi

printf 'codex-host-bridge: invoking Codex for task %s\n' "${TASK_ID}" >&2

CODEX_ARGS=(--ask-for-approval never)
if [ -n "${AGENT_CREW_AGENT_REQUEST_ID:-}" ]; then
  CODEX_ARGS+=(--sandbox "${AGENT_CREW_CODEX_DIRECT_AGENT_SANDBOX:-read-only}")
fi
CODEX_ARGS+=(exec)
if [ -n "${AGENT_CREW_AGENT_REQUEST_ID:-}" ]; then
  CODEX_ARGS+=(
    -C "${TASK_DIR}"
    --skip-git-repo-check
  )
else
  CODEX_ARGS+=(
    -C "${PROJECT_ROOT}"
    --add-dir "${TASK_DIR}"
  )
fi
CODEX_ARGS+=(-o "${LAST_MESSAGE_PATH}" -)

set +e
AGENT_CREW_HOST_BRIDGE_ACTIVE=1 \
AGENT_CREW_AUTO_ROUTE_DISABLED=1 \
  "${CODEX_BIN}" "${CODEX_ARGS[@]}" < "${PROMPT_PATH}" \
    > "${STDOUT_LOG}" 2> "${STDERR_LOG}"
CODEX_RC=$?
set -e

cat "${STDERR_LOG}" >&2
cat "${STDOUT_LOG}"
cat "${STDOUT_LOG}" "${STDERR_LOG}" > "${OUTPUT_LOG}" 2>/dev/null || true
record_token_usage
exit "${CODEX_RC}"
