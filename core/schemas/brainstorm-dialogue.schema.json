{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-crew/schemas/brainstorm-dialogue.schema.json",
  "title": "agent-crew Brainstorm dialogue",
  "description": "Optional structured Brainstorm dialogue artifact. Lives at {TASK_DIR}/context/brainstorm-dialogue.json. A task may have only one active question at a time.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "classification",
    "status",
    "questions",
    "section_acknowledgements"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[0-9]{6}(-[0-9]+)?$"
    },
    "classification": {
      "type": "string",
      "enum": ["Spike", "Bounded", "Architectural"]
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "waiting_for_input",
        "design_review",
        "ready_for_approval",
        "accepted",
        "blocked"
      ]
    },
    "active_question_id": {
      "type": "string",
      "minLength": 1,
      "description": "The one unanswered question for this task, when waiting for input."
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "header",
          "prompt",
          "options",
          "why_it_matters",
          "status"
        ],
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "header": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["option_id", "label", "description"],
              "properties": {
                "option_id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "why_it_matters": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["pending", "answered", "cancelled"]
          },
          "response": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selected_option_id", "idempotency_key", "answered_at"],
            "properties": {
              "selected_option_id": {
                "type": "string",
                "minLength": 1
              },
              "idempotency_key": {
                "type": "string",
                "minLength": 1
              },
              "answered_at": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "section_acknowledgements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "idempotency_key", "acknowledged_at"],
        "properties": {
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1
          },
          "acknowledged_at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
