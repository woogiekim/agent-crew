{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-crew/schemas/brainstorm-approval.schema.json",
  "title": "agent-crew Brainstorm approval decisions",
  "description": "Optional Brainstorm approval artifact. Lives at {TASK_DIR}/context/brainstorm-approval.json and records downgrade, design/execution decisions, and append-only approval_invalidation events. Later invalidation preserves and references the original decision. The existing approval.md remains the execution-approval protocol.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "decisions"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[0-9]{6}(-[0-9]+)?$"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_id",
          "approval_kind",
          "status",
          "design_hash",
          "bound_fields",
          "created_at"
        ],
        "properties": {
          "decision_id": {
            "type": "string",
            "minLength": 1
          },
          "approval_kind": {
            "type": "string",
            "enum": ["architectural_design", "architectural_execution", "bounded_combined", "user_downgrade", "approval_invalidation"]
          },
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "cancelled", "invalidated"]
          },
          "design_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bound_fields": {
            "type": "object",
            "description": "Canonical design fields plus classification_hash. Execution decisions also bind execution_plan_hash; architectural_execution references its approved design_decision_id and context/approval.md signal.",
            "properties": {
              "classification_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "execution_plan_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "design_decision_id": {"type": "string", "minLength": 1},
              "approval_signal_path": {"type": "string", "const": "context/approval.md"},
              "invalidates_decision_id": {"type": "string", "minLength": 1},
              "previous_hashes": {"type": "object"},
              "current_hashes": {"type": "object"}
            }
          },
          "created_at": {
            "type": "string",
            "minLength": 1
          },
          "decision_at": {
            "type": "string",
            "minLength": 1
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          }
        },
        "oneOf": [
          {
            "properties": {
              "approval_kind": {
                "enum": ["architectural_design", "architectural_execution", "bounded_combined", "user_downgrade"]
              },
              "status": {
                "enum": ["pending"]
              }
            }
          },
          {
            "required": ["decision_at"],
            "properties": {
              "approval_kind": {
                "enum": ["architectural_design", "architectural_execution", "bounded_combined", "user_downgrade"]
              },
              "status": {
                "enum": ["approved", "cancelled", "invalidated"]
              },
              "decision_at": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": ["decision_at", "reason"],
            "properties": {
              "approval_kind": {"const": "approval_invalidation"},
              "status": {"const": "invalidated"},
              "reason": {"type": "string", "minLength": 1},
              "bound_fields": {
                "required": ["invalidates_decision_id", "previous_hashes", "current_hashes"]
              }
            }
          }
        ]
      }
    }
  }
}
