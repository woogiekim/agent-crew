{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Variant Synthesis State",
  "type": "object",
  "required": ["schema_version", "artifact_kind", "status", "input_hash", "inputs_hash", "document_hash", "base_commit", "attempt", "token", "task_id", "task_dir", "project_root", "base_project_root", "branch", "snapshots", "history", "validation_attempts", "max_validation_attempts"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_kind": {"const": "synthesis"},
    "status": {"enum": ["preparing", "running", "validating", "needs_changes", "blocked", "failed", "stale", "released", "ready_for_apply"]},
    "input_hash": {"type": "string", "minLength": 1},
    "inputs_hash": {"type": "string", "minLength": 1},
    "document_hash": {"type": "string", "minLength": 1},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "attempt": {"type": "integer", "minimum": 1},
    "token": {"type": ["string", "null"]},
    "host_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string"},
    "task_dir": {"type": "string"},
    "project_root": {"type": "string"},
    "base_project_root": {"type": "string"},
    "branch": {"type": "string"},
    "snapshots": {"type": "object"},
    "history": {"type": "array", "items": {"type": "object"}},
    "validation_attempts": {"type": "integer", "minimum": 0},
    "max_validation_attempts": {"type": "integer", "minimum": 1},
    "execution_attempts": {"type": "integer", "minimum": 1},
    "max_execution_attempts": {"type": "integer", "minimum": 1},
    "commit": {"type": "string"},
    "last_result": {},
    "result": {
      "type": "object",
      "required": ["commit", "implementer_id", "reviewer_id", "verdict", "unresolved_findings", "acceptance", "decision_results", "composition_checks", "analysis"],
      "properties": {
        "commit": {"type": "string"},
        "implementer_id": {"type": "string", "minLength": 1},
        "reviewer_id": {"type": "string", "minLength": 1},
        "verdict": {"enum": ["approved", "needs_changes"]},
        "unresolved_findings": {"type": "array"},
        "acceptance": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/check"}, {"required": ["requirement_id"]}]}},
        "decision_results": {
          "type": "array",
          "items": {"type": "object", "required": ["decision_id", "implemented", "evidence", "validation"],
            "properties": {"decision_id": {"type": "string"}, "implemented": {"type": "boolean"},
              "evidence": {"type": "array", "minItems": 1}, "validation": {"$ref": "#/$defs/check"}}}
        },
        "composition_checks": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/check"}, {"required": ["name"]}]}},
        "analysis": {"type": "array", "minItems": 1}
      }
    },
    "log_hashes": {"type": "object", "additionalProperties": {"type": "string"}},
    "error": {"type": "string"}
  },
  "$defs": {
    "check": {"type": "object", "required": ["passed", "command", "log"],
      "properties": {"passed": {"type": "boolean"}, "command": {"type": "string", "minLength": 1}, "log": {"type": "string", "minLength": 1}}}
  }
}
