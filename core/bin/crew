#!/usr/bin/env bash
# crew - deterministic shell entrypoint for agent-crew.

set -euo pipefail

AGENT_CREW_HOME="${AGENT_CREW_HOME:-${HOME}/.agent-crew}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -d "${SCRIPT_DIR}/../commands" ] && [ -d "${SCRIPT_DIR}/../scripts" ]; then
  ASSET_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
else
  ASSET_ROOT="${AGENT_CREW_HOME}"
fi

SOURCE_ROOT="${ASSET_ROOT}"
if [ -d "${ASSET_ROOT}/../adapters" ] && [ "$(basename "${ASSET_ROOT}")" = "core" ]; then
  SOURCE_ROOT="$(cd "${ASSET_ROOT}/.." && pwd)"
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
PROJECT_ROOT="${PROJECT_ROOT:-${REPO_ROOT}}"
PROJECT_NAME="$(basename "${PROJECT_ROOT}")"
STATE_DIR="${AGENT_CREW_HOME}/state/${PROJECT_NAME}"

usage() {
  cat <<'EOF'
usage: crew <command> [args]

agent-crew is a local control plane for AI-host prompt workflows. The host AI
remains the execution plane; crew provides setup, state, handoff, audit, and
adapter-sync helpers around that prompt runtime.

Commands:
  setup [PROJECT_ROOT]             Install/refresh host adapter for a project
  status [--json] [--recent N]     Show deterministic local task state
  telemetry [args]                 Show timing, retry, blocker, and token metrics
  trace [args]                     Show per-task progress trace events
  cost [args]                      Show token/cost aggregate metrics
  doctor [args]                    Run framework operational readiness checks
  config doctor|dump [args]        Show effective configuration and drift
  debug [args]                     Run doctor + recent telemetry + cost snapshot
  readiness evidence|metrics|gate|workload [args]
                                    Generate readiness evidence, metrics, or gate report
  resume [--print|--dry-run] TASK_ID
                                    Request or print deterministic resume state
  update [--local [SOURCE_ROOT]]   Refresh installed assets
  run "task"                       Write state and host handoff for a task
  report auto|publish [args]       Store/publish native agent-crew reports
  issue-ingest ISSUE [args]        Record issue body/comment ingestion evidence
  cancel [--note TEXT] TASK_ID     Mark a superseded handoff as cancelled
  repair [args] TASK_ID            Repair a manually completed handoff task
  cleanup-host-bridge [args]       Bulk repair stale host bridge blockers
  cleanup-state [args]             Dry-run task-state cleanup/archive plan
  agent [name] [question]          Write direct-agent host handoff state
  help                             Show this help

Notes:
  crew setup/status/update and the crew run/agent state transitions are native
  shell paths. The host runtime such as Codex or Claude still performs execution.
EOF
}

die() {
  printf 'crew: %s\n' "$*" >&2
  exit 2
}

require_file() {
  local path="$1" label="$2"
  [ -f "${path}" ] || die "${label} not found at ${path}; install agent-crew first"
}

find_source_checkout() {
  local source
  for source in "${AGENT_CREW_SOURCE_DIR:-}" "${PROJECT_ROOT}" "${SOURCE_ROOT}"; do
    [ -n "${source}" ] || continue
    if [ -d "${source}/core" ] && [ -d "${source}/adapters" ]; then
      (cd "${source}" && pwd)
      return 0
    fi
  done
  return 1
}

copy_flat_assets() {
  local src="$1" dest="$2" pattern="$3"
  [ -d "${src}" ] || return 0
  mkdir -p "${dest}"
  # shellcheck disable=SC2086
  cp -f "${src}"/${pattern} "${dest}/" 2>/dev/null || true
}

copy_tree_assets() {
  local src="$1" dest="$2"
  [ -d "${src}" ] || return 0
  mkdir -p "${dest}"
  cp -rf "${src}/." "${dest}/"
}

absolute_file_path() {
  local path="$1" dir base
  [ -n "${path}" ] || return 1
  case "${path}" in
    /*) ;;
    *) path="$(pwd)/${path}" ;;
  esac
  dir="$(dirname "${path}")"
  base="$(basename "${path}")"
  [ -d "${dir}" ] || return 1
  printf '%s/%s\n' "$(cd "${dir}" && pwd)" "${base}"
}

is_managed_crew_cli() {
  local path="$1"
  [ -f "${path}" ] || return 1
  grep -q "experimental Codex launcher for agent-crew\\|deterministic shell entrypoint for agent-crew" "${path}" 2>/dev/null
}

sync_managed_path_crew_cli() {
  local source_crew="$1" candidate resolved
  [ -f "${source_crew}" ] || return 0

  for candidate in \
    "${BASH_SOURCE[0]:-}" \
    "$(command -v crew 2>/dev/null || true)" \
    "${AGENT_CREW_PATH_BIN:-${HOME}/.local/bin}/crew"; do
    resolved="$(absolute_file_path "${candidate}" 2>/dev/null || true)"
    [ -n "${resolved}" ] || continue
    [ -f "${resolved}" ] || continue
    is_managed_crew_cli "${resolved}" || continue
    cmp -s "${source_crew}" "${resolved}" 2>/dev/null && continue
    cp -f "${source_crew}" "${resolved}"
    chmod +x "${resolved}"
  done
}

sync_source_runtime_assets_if_drifted() {
  [ "${AGENT_CREW_AUTO_SYNC_RUNTIME_ON_RUN:-1}" = "1" ] || return 0

  local source
  source="$(find_source_checkout 2>/dev/null || true)"
  [ -n "${source}" ] || return 0

  local drift=0 check
  for check in \
    "core/bin/crew:${AGENT_CREW_HOME}/bin/crew" \
    "core/scripts/crew-runtime.py:${AGENT_CREW_HOME}/scripts/crew-runtime.py" \
    "core/scripts/crew-diagnostics.py:${AGENT_CREW_HOME}/scripts/crew-diagnostics.py" \
    "core/scripts/repair-task-state.py:${AGENT_CREW_HOME}/scripts/repair-task-state.py" \
    "core/scripts/pipeline-quality-plan-check.py:${AGENT_CREW_HOME}/scripts/pipeline-quality-plan-check.py" \
    "core/scripts/quality-loop-check.py:${AGENT_CREW_HOME}/scripts/quality-loop-check.py" \
    "core/scripts/quality_loop_lib.py:${AGENT_CREW_HOME}/scripts/quality_loop_lib.py" \
    "core/scripts/reviewer-loop-decision.py:${AGENT_CREW_HOME}/scripts/reviewer-loop-decision.py" \
    "core/scripts/cleanup-host-bridge-blockers.py:${AGENT_CREW_HOME}/scripts/cleanup-host-bridge-blockers.py" \
    "core/scripts/cleanup-task-state.py:${AGENT_CREW_HOME}/scripts/cleanup-task-state.py" \
    "core/scripts/core_objective_lib.py:${AGENT_CREW_HOME}/scripts/core_objective_lib.py" \
    "core/scripts/codex-workflow-guard.py:${AGENT_CREW_HOME}/scripts/codex-workflow-guard.py" \
    "core/scripts/crew-cli-cleanup.sh:${AGENT_CREW_HOME}/scripts/crew-cli-cleanup.sh" \
    "core/scripts/cost-aggregate.py:${AGENT_CREW_HOME}/scripts/cost-aggregate.py" \
    "core/scripts/memory-gc.py:${AGENT_CREW_HOME}/scripts/memory-gc.py" \
    "core/scripts/framework-review-check.py:${AGENT_CREW_HOME}/scripts/framework-review-check.py" \
    "core/scripts/agent-capability-check.py:${AGENT_CREW_HOME}/scripts/agent-capability-check.py" \
    "core/scripts/pipeline-capability-check.py:${AGENT_CREW_HOME}/scripts/pipeline-capability-check.py" \
    "core/scripts/workflow-replay-check.py:${AGENT_CREW_HOME}/scripts/workflow-replay-check.py" \
    "core/scripts/retry-chaos-check.py:${AGENT_CREW_HOME}/scripts/retry-chaos-check.py" \
    "core/scripts/telemetry-taxonomy-check.py:${AGENT_CREW_HOME}/scripts/telemetry-taxonomy-check.py" \
    "core/scripts/auto-issue-reporter.py:${AGENT_CREW_HOME}/scripts/auto-issue-reporter.py" \
    "core/scripts/e2e-slo-check.py:${AGENT_CREW_HOME}/scripts/e2e-slo-check.py" \
    "core/scripts/update-slo-benchmark.py:${AGENT_CREW_HOME}/scripts/update-slo-benchmark.py" \
    "core/scripts/generate-release-checksums.py:${AGENT_CREW_HOME}/scripts/generate-release-checksums.py" \
    "core/scripts/readiness-metrics.py:${AGENT_CREW_HOME}/scripts/readiness-metrics.py" \
    "core/scripts/readiness-gate.py:${AGENT_CREW_HOME}/scripts/readiness-gate.py" \
    "core/scripts/readiness-workload-validate.py:${AGENT_CREW_HOME}/scripts/readiness-workload-validate.py" \
    "core/scripts/hosted-workload-evidence.py:${AGENT_CREW_HOME}/scripts/hosted-workload-evidence.py" \
    "core/scripts/check-host-bridge.py:${AGENT_CREW_HOME}/scripts/check-host-bridge.py" \
    "core/scripts/verify-install-drift.py:${AGENT_CREW_HOME}/scripts/verify-install-drift.py" \
    "core/commands/run.md:${AGENT_CREW_HOME}/commands/run.md" \
    "core/rules/prompt-injection-defense.md:${AGENT_CREW_HOME}/rules/prompt-injection-defense.md" \
    "core/evaluations/memory-retrieval.json:${AGENT_CREW_HOME}/evaluations/memory-retrieval.json" \
    "core/evaluations/workflow-replay.json:${AGENT_CREW_HOME}/evaluations/workflow-replay.json" \
    "core/evaluations/retry-chaos.json:${AGENT_CREW_HOME}/evaluations/retry-chaos.json" \
    "core/policies/agent-capabilities.json:${AGENT_CREW_HOME}/policies/agent-capabilities.json" \
    "core/schemas/agent-capabilities.schema.json:${AGENT_CREW_HOME}/schemas/agent-capabilities.schema.json"; do
    local src_rel="${check%%:*}" dest="${check#*:}"
    if [ -f "${source}/${src_rel}" ] && ! cmp -s "${source}/${src_rel}" "${dest}" 2>/dev/null; then
      drift=1
      break
    fi
  done
  [ "${drift}" = "1" ] || return 0

  copy_flat_assets "${source}/core/commands" "${AGENT_CREW_HOME}/system/commands" "*.md"
  copy_flat_assets "${source}/core/commands" "${AGENT_CREW_HOME}/commands" "*.md"
  copy_tree_assets "${source}/core/rules" "${AGENT_CREW_HOME}/system/rules"
  copy_tree_assets "${source}/core/rules" "${AGENT_CREW_HOME}/rules"
  copy_flat_assets "${source}/core/hooks" "${AGENT_CREW_HOME}/system/hooks" "*.sh"
  copy_flat_assets "${source}/core/hooks" "${AGENT_CREW_HOME}/hooks" "*.sh"
  copy_tree_assets "${source}/core/scripts" "${AGENT_CREW_HOME}/system/scripts"
  copy_tree_assets "${source}/core/scripts" "${AGENT_CREW_HOME}/scripts"
  copy_tree_assets "${source}/core/evaluations" "${AGENT_CREW_HOME}/system/evaluations"
  copy_tree_assets "${source}/core/evaluations" "${AGENT_CREW_HOME}/evaluations"
  copy_tree_assets "${source}/core/policies" "${AGENT_CREW_HOME}/system/policies"
  copy_tree_assets "${source}/core/policies" "${AGENT_CREW_HOME}/policies"
  copy_flat_assets "${source}/core/bin" "${AGENT_CREW_HOME}/bin" "*"
  sync_managed_path_crew_cli "${source}/core/bin/crew"
  copy_flat_assets "${source}/core/schemas" "${AGENT_CREW_HOME}/system/schemas" "*.json"
  copy_flat_assets "${source}/core/schemas" "${AGENT_CREW_HOME}/schemas" "*.json"
  chmod +x \
    "${AGENT_CREW_HOME}/system/hooks/"*.sh "${AGENT_CREW_HOME}/hooks/"*.sh \
    "${AGENT_CREW_HOME}/system/scripts/"*.sh "${AGENT_CREW_HOME}/scripts/"*.sh \
    "${AGENT_CREW_HOME}/system/scripts/"*.py "${AGENT_CREW_HOME}/scripts/"*.py \
    "${AGENT_CREW_HOME}/bin/"* \
    2>/dev/null || true

  printf 'crew: refreshed runtime assets from source checkout because installed assets drifted\n' >&2
}

sync_source_hooks_if_drifted() {
  [ "${AGENT_CREW_AUTO_SYNC_HOOKS_ON_RUN:-1}" = "1" ] || return 0

  local source source_hooks=""
  source="$(find_source_checkout 2>/dev/null || true)"
  [ -n "${source}" ] && source_hooks="${source}/core/hooks"
  [ -n "${source_hooks}" ] || return 0

  local drift=0 hook base dest
  for hook in "${source_hooks}"/*.sh; do
    [ -f "${hook}" ] || continue
    base="$(basename "${hook}")"
    for dest in "${AGENT_CREW_HOME}/system/hooks/${base}" "${AGENT_CREW_HOME}/hooks/${base}"; do
      if ! cmp -s "${hook}" "${dest}" 2>/dev/null; then
        drift=1
        break 2
      fi
    done
    if [ -d "${PROJECT_ROOT}/.agent-crew/hooks" ] \
      && ! cmp -s "${hook}" "${PROJECT_ROOT}/.agent-crew/hooks/${base}" 2>/dev/null; then
      drift=1
      break
    fi
    if [ -d "${PROJECT_ROOT}/.codex/hooks" ] \
      && ! cmp -s "${hook}" "${PROJECT_ROOT}/.codex/hooks/${base}" 2>/dev/null; then
      drift=1
      break
    fi
  done
  [ "${drift}" = "1" ] || return 0

  mkdir -p "${AGENT_CREW_HOME}/system/hooks" "${AGENT_CREW_HOME}/hooks"
  cp -f "${source_hooks}/"*.sh "${AGENT_CREW_HOME}/system/hooks/" 2>/dev/null || true
  cp -f "${source_hooks}/"*.sh "${AGENT_CREW_HOME}/hooks/" 2>/dev/null || true
  chmod +x "${AGENT_CREW_HOME}/system/hooks/"*.sh "${AGENT_CREW_HOME}/hooks/"*.sh 2>/dev/null || true

  if [ -d "${PROJECT_ROOT}/.agent-crew/hooks" ]; then
    cp -f "${source_hooks}/"*.sh "${PROJECT_ROOT}/.agent-crew/hooks/" 2>/dev/null || true
    chmod +x "${PROJECT_ROOT}/.agent-crew/hooks/"*.sh 2>/dev/null || true
  fi
  if [ -d "${PROJECT_ROOT}/.codex/hooks" ]; then
    cp -f "${source_hooks}/"*.sh "${PROJECT_ROOT}/.codex/hooks/" 2>/dev/null || true
    chmod +x "${PROJECT_ROOT}/.codex/hooks/"*.sh 2>/dev/null || true
  fi

  printf 'crew: refreshed auto-route hooks from source checkout because installed hooks drifted\n' >&2
}

cmd_setup() {
  local project="${1:-${PROJECT_ROOT}}"
  local setup_script="${ASSET_ROOT}/setup/setup-host.sh"
  local install_setup="${AGENT_CREW_HOME}/setup/setup-host.sh"

  if [ ! -x "${install_setup}" ] && [ "${ASSET_ROOT}" != "${AGENT_CREW_HOME}" ]; then
    local sync_script="${ASSET_ROOT}/scripts/sync-local-install.sh"
    require_file "${sync_script}" "local sync script"
    bash "${sync_script}" "${SOURCE_ROOT}" "${project}"
    return
  fi

  require_file "${setup_script}" "setup dispatcher"
  bash "${setup_script}" "${project}"
}

cmd_status_json() {
  local recent="${1:-10}"
  local telemetry="${ASSET_ROOT}/scripts/telemetry-aggregate.py"
  if [ -f "${telemetry}" ]; then
    if grep -q -- "--project-root" "${telemetry}" 2>/dev/null; then
      python3 "${telemetry}" --state-dir "${STATE_DIR}" --project-root "${PROJECT_ROOT}" --recent "${recent}" --format json
    else
      python3 "${telemetry}" --state-dir "${STATE_DIR}" --recent "${recent}" --format json
    fi
    return
  fi
  printf '{"project":"%s","state_dir":"%s","error":"telemetry script not found"}\n' \
    "${PROJECT_NAME}" "${STATE_DIR}"
}

cmd_status() {
  local format="text"
  local recent="10"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) format="json"; shift ;;
      --recent)
        [ -n "${2:-}" ] || die "--recent requires a number"
        recent="$2"
        shift 2
        ;;
      -h|--help)
        cat <<'EOF'
usage: crew status [--json] [--recent N]

Reads ~/.agent-crew/state/<project>/ and prints local task telemetry.
EOF
        return 0
        ;;
      *) die "unknown status argument: $1" ;;
    esac
  done

  if [ "${format}" = "json" ]; then
    cmd_status_json "${recent}"
    return
  fi

  printf 'Project: %s\n' "${PROJECT_NAME}"
  printf 'State  : %s\n\n' "${STATE_DIR}"

  if [ ! -d "${STATE_DIR}/tasks" ]; then
    printf 'No tasks found. Run crew setup first, then use crew:run in your host runtime.\n'
    return 0
  fi

  local telemetry="${ASSET_ROOT}/scripts/telemetry-aggregate.py"
  if [ -f "${telemetry}" ]; then
    if grep -q -- "--project-root" "${telemetry}" 2>/dev/null; then
      python3 "${telemetry}" --state-dir "${STATE_DIR}" --project-root "${PROJECT_ROOT}" --recent "${recent}" --format text
    else
      python3 "${telemetry}" --state-dir "${STATE_DIR}" --recent "${recent}" --format text
    fi
  else
    find "${STATE_DIR}/tasks" -mindepth 1 -maxdepth 1 -type d | sort | tail -"${recent}"
  fi
}

cmd_telemetry() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew telemetry [--task-id ID] [--session-id ID] [--recent N] [--format text|json]

Reads ~/.agent-crew/state/<project>/ and prints pipeline timing, retry,
blocker, and token telemetry.
EOF
    return 0
  fi

  local telemetry="${ASSET_ROOT}/scripts/telemetry-aggregate.py"
  require_file "${telemetry}" "telemetry aggregator"

  if [ ! -d "${STATE_DIR}/tasks" ]; then
    printf 'No tasks found. Run crew setup first, then use crew run in your host runtime.\n'
    return 0
  fi

  if grep -q -- "--project-root" "${telemetry}" 2>/dev/null; then
    python3 "${telemetry}" --state-dir "${STATE_DIR}" --project-root "${PROJECT_ROOT}" "$@"
  else
    python3 "${telemetry}" --state-dir "${STATE_DIR}" "$@"
  fi
}

cmd_trace() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew trace [--task-id ID] [--recent N] [--format text|json] [--include-tools]

Prints structured progress events from progress.buffer.jsonl, falling back to
progress.log for pre-trace task state. With --include-tools, also prints
tool-events.jsonl entries keyed by trace_id. Read-only.
EOF
    return 0
  fi

  local task_id=""
  local recent="1"
  local format="text"
  local include_tools="0"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --task-id)
        [ -n "${2:-}" ] || die "--task-id requires an id"
        task_id="$2"
        shift 2
        ;;
      --recent)
        [ -n "${2:-}" ] || die "--recent requires a number"
        recent="$2"
        shift 2
        ;;
      --format)
        [ -n "${2:-}" ] || die "--format requires text or json"
        format="$2"
        shift 2
        ;;
      --include-tools) include_tools="1"; shift ;;
      *) die "unknown trace argument: $1" ;;
    esac
  done
  case "${format}" in text|json) ;; *) die "--format must be text or json" ;; esac

  python3 - "${STATE_DIR}" "${task_id}" "${recent}" "${format}" "${include_tools}" <<'PYEOF'
import json, sys
from pathlib import Path

state_dir = Path(sys.argv[1])
task_id = sys.argv[2]
try:
    recent = max(1, int(sys.argv[3]))
except Exception:
    recent = 1
fmt = sys.argv[4]
include_tools = sys.argv[5] == "1"
tasks_root = state_dir / "tasks"

def task_dirs():
    if not tasks_root.is_dir():
        return []
    if task_id:
        p = tasks_root / task_id
        return [p] if p.is_dir() else []
    dirs = [p for p in tasks_root.iterdir() if p.is_dir()]
    dirs.sort(key=lambda p: p.stat().st_mtime, reverse=True)
    return dirs[:recent]

def read_buffer(path):
    rows = []
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            row = json.loads(line)
        except Exception:
            continue
        rows.append({
            "ts": row.get("ts", ""),
            "task_id": row.get("task_id", ""),
            "trace_id": row.get("trace_id", ""),
            "event": row.get("event", ""),
            "stage": row.get("stage", 0),
            "agent": row.get("agent", ""),
            "attempt": row.get("attempt", 0),
            "status": row.get("status", ""),
            "detail": row.get("detail", ""),
        })
    return rows

def read_log(path, tid):
    rows = []
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        parts = [p.strip() for p in line.split("|", 2)]
        if len(parts) == 3:
            ts, event, detail = parts
        else:
            ts, event, detail = "", "LOG", line.strip()
        rows.append({
            "ts": ts,
            "task_id": tid,
            "trace_id": "",
            "event": event,
            "stage": 0,
            "agent": "",
            "attempt": 0,
            "status": "",
            "detail": detail,
        })
    return rows

def read_tool_events(path):
    rows = []
    if not path.is_file():
        return rows
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            row = json.loads(line)
        except Exception:
            continue
        rows.append({
            "trace_id": row.get("trace_id", ""),
            "tool_name": row.get("tool_name", ""),
            "action_summary": row.get("action_summary", ""),
            "started_at": row.get("started_at", ""),
            "ended_at": row.get("ended_at", ""),
            "status": row.get("status", ""),
            "exit_code": row.get("exit_code"),
            "token_usage_ref": row.get("token_usage_ref", ""),
            "failure_class": row.get("failure_class", ""),
        })
    return rows

payload = []
for td in task_dirs():
    buffer = td / "progress.buffer.jsonl"
    log = td / "progress.log"
    rows = read_buffer(buffer) if buffer.is_file() else (read_log(log, td.name) if log.is_file() else [])
    item = {"task_id": td.name, "task_dir": str(td), "events": rows}
    if include_tools:
        item["tools"] = read_tool_events(td / "tool-events.jsonl")
    payload.append(item)

if fmt == "json":
    print(json.dumps({"state_dir": str(state_dir), "tasks": payload}, ensure_ascii=False, indent=2))
else:
    if not payload:
        print("No trace events found.")
    for item in payload:
        print(f"Task: {item['task_id']}")
        print(f"Dir : {item['task_dir']}")
        if not item["events"]:
            print("  (no events)")
            continue
        for row in item["events"]:
            trace = f" trace={row['trace_id']}" if row["trace_id"] else ""
            agent = f" agent={row['agent']}" if row["agent"] else ""
            print(f"  {row['ts']} {row['event']} status={row['status']} stage={row['stage']} attempt={row['attempt']}{agent}{trace} | {row['detail']}")
        if include_tools:
            tools = item.get("tools", [])
            print("  Tools:")
            if not tools:
                print("    (no tool events)")
            for row in tools:
                exit_part = "" if row["exit_code"] is None else f" exit={row['exit_code']}"
                failure = f" failure={row['failure_class']}" if row["failure_class"] else ""
                print(f"    {row['started_at']} {row['tool_name']} status={row['status']}{exit_part}{failure} trace={row['trace_id']} | {row['action_summary']}")
PYEOF
}

cmd_cost() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew cost [--task-id ID] [--session-id ID] [--recent N] [--format json|table]

Reads ~/.agent-crew/state/<project>/cost/*.jsonl and prints token/cost
aggregate metrics used by the supervisor cost circuit breaker.
EOF
    return 0
  fi

  local cost="${ASSET_ROOT}/scripts/cost-aggregate.py"
  require_file "${cost}" "cost aggregator"
  python3 "${cost}" --state-dir "${STATE_DIR}" "$@"
}

cmd_doctor() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew doctor [--mode static|runtime|host|all] [--format text|json]

Runs split operational checks. static delegates to framework review, runtime
uses safe local probes, and host checks adapter/config visibility.
EOF
    return 0
  fi

  local diagnostics="${ASSET_ROOT}/scripts/crew-diagnostics.py"
  require_file "${diagnostics}" "diagnostics helper"
  python3 "${diagnostics}" --project-root "${PROJECT_ROOT}" --asset-root "${ASSET_ROOT}" --agent-crew-home "${AGENT_CREW_HOME}" doctor "$@"
}

cmd_config() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew config doctor [--format text|json]
       crew config dump --effective [--format text|json]

Shows centralized effective configuration: capability flags, active adapter,
budgets, timeouts, report settings, memory backend, state directory, and
install drift status.
EOF
    return 0
  fi

  local diagnostics="${ASSET_ROOT}/scripts/crew-diagnostics.py"
  require_file "${diagnostics}" "diagnostics helper"
  python3 "${diagnostics}" --project-root "${PROJECT_ROOT}" --asset-root "${ASSET_ROOT}" --agent-crew-home "${AGENT_CREW_HOME}" config "$@"
}

cmd_debug() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew debug [--recent N]

Runs read-only operator diagnostics: doctor, recent telemetry, and recent cost
summary. It never mutates workflow state.
EOF
    return 0
  fi

  local recent="5"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --recent)
        [ -n "${2:-}" ] || die "--recent requires a number"
        recent="$2"
        shift 2
        ;;
      *) die "unknown debug argument: $1" ;;
    esac
  done

  printf '== doctor ==\n'
  cmd_doctor || true
  printf '\n== telemetry ==\n'
  cmd_telemetry --recent "${recent}" || true
  printf '\n== cost ==\n'
  cmd_cost --recent "${recent}" --format table || true
}

cmd_readiness() {
  local sub="${1:-}"
  shift || true

  case "${sub}" in
    evidence)
      local helper="${ASSET_ROOT}/scripts/hosted-workload-evidence.py"
      require_file "${helper}" "hosted workload evidence helper"
      python3 "${helper}" --state-dir "${STATE_DIR}" "$@"
      ;;
    metrics)
      local helper="${ASSET_ROOT}/scripts/readiness-metrics.py"
      require_file "${helper}" "readiness metrics helper"
      python3 "${helper}" "$@"
      ;;
    gate)
      local helper="${ASSET_ROOT}/scripts/readiness-gate.py"
      require_file "${helper}" "readiness gate helper"
      python3 "${helper}" --state-dir "${STATE_DIR}" "$@"
      ;;
    workload)
      local helper="${ASSET_ROOT}/scripts/readiness-workload-validate.py"
      require_file "${helper}" "readiness workload validation helper"
      python3 "${helper}" --crew-bin "${ASSET_ROOT}/bin/crew" "$@"
      ;;
    -h|--help|"")
      cat <<'EOF'
usage: crew readiness evidence [--recent N] [--include-agent-requests] [--output PATH] [--format text|json]
       crew readiness metrics [readiness-metrics.py args]
       crew readiness gate [--validation-report PATH] [--include-agent-requests] [readiness-gate.py args]
       crew readiness workload [--output PATH] [--format text|json]

Generate local workload evidence from agent-crew task state, then feed that
evidence into commercial readiness metric aggregation, a default-threshold
readiness gate with blocker reporting, or an explicit deterministic validation
workload evidence file.
EOF
      ;;
    *)
      die "unknown readiness subcommand: ${sub}"
      ;;
  esac
}

cmd_resume() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew resume [--print|--dry-run] TASK_ID

Default mode records a RESUME_REQUESTED state event, then prints deterministic
resume coordinates for the host prompt runtime. --print and --dry-run preserve
the read-only behavior.
EOF
    return 0
  fi

  local task_id="" mode="request"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --print|--dry-run) mode="print"; shift ;;
      *)
        [ -z "${task_id}" ] || die "resume accepts one TASK_ID"
        task_id="$1"
        shift
        ;;
    esac
  done
  python3 - "${STATE_DIR}" "${task_id}" "${mode}" <<'PYEOF'
import json, re, sys
from datetime import datetime, timezone
from pathlib import Path

state_dir = Path(sys.argv[1])
requested = sys.argv[2]
mode = sys.argv[3]
tasks_root = state_dir / "tasks"

def read_json(path):
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}

def result_status(task_dir):
    text = (task_dir / "result.md").read_text(encoding="utf-8", errors="replace") if (task_dir / "result.md").is_file() else ""
    m = re.search(r"^STATUS:\s*(\w+)", text, re.I | re.M)
    return m.group(1).lower() if m else ""

def missing_required_markers(task_dir):
    required = ("handoff.md", "pipeline.json", "register.json")
    return [name for name in required if not (task_dir / name).is_file()]

if not tasks_root.is_dir():
    print("No tasks found. Run crew setup first, then use crew run in your host runtime.")
    raise SystemExit(0)

if requested:
    candidates = [tasks_root / requested]
else:
    candidates = [p for p in tasks_root.iterdir() if p.is_dir()]
    def key(path):
        status = result_status(path)
        active = 0 if status == "completed" else 1
        return (active, path.stat().st_mtime)
    candidates.sort(key=key, reverse=True)

task_dir = next((p for p in candidates if p.is_dir()), None)
if task_dir is None:
    print(f"Task not found: {requested}")
    raise SystemExit(2)

if mode == "request":
    missing = missing_required_markers(task_dir)
    if missing:
        print("STATUS: blocked")
        print("BLOCKER: missing_required_state_markers")
        print(f"TASK_DIR: {task_dir}")
        print(f"MISSING: {', '.join(missing)}")
        print("NEXT: Run crew run to create workflow state, or resume from a valid TASK_DIR.")
        raise SystemExit(2)

register = read_json(task_dir / "register.json")
pipeline = read_json(task_dir / "pipeline.json")
status = result_status(task_dir) or register.get("current_phase") or "unknown"
task = register.get("task") or ""
if not task and (task_dir / "task.txt").is_file():
    task = (task_dir / "task.txt").read_text(encoding="utf-8", errors="replace").strip()
handoff = register.get("handoff_path") or str(task_dir / "handoff.md")
completed = pipeline.get("completed_stages", "unknown")
stages = pipeline.get("stages") or []

if mode == "request":
    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    session_id = register.get("session_id") or task_dir.name.rsplit("-", 1)[0]
    trace_id = f"{session_id}.{task_dir.name}.0.0"
    event = {
        "ts": now,
        "trace_id": trace_id,
        "task_id": task_dir.name,
        "session_id": session_id,
        "event": "RESUME_REQUESTED",
        "stage": 0,
        "agent": "",
        "attempt": 0,
        "status": "in_progress",
        "detail": "resume requested via crew resume",
        "files": ["handoff.md"],
    }
    with (task_dir / "progress.buffer.jsonl").open("a", encoding="utf-8") as f:
        f.write(json.dumps(event, ensure_ascii=False, sort_keys=True) + "\n")
    with (task_dir / "progress.log").open("a", encoding="utf-8") as f:
        f.write(f"{now} | RESUME_REQUESTED | resume requested via crew resume\n")

print(f"TASK_ID: {task_dir.name}")
print(f"TASK_DIR: {task_dir}")
print(f"STATUS: {status}")
print(f"STAGES: {completed}/{len(stages) if isinstance(stages, list) else 'unknown'}")
if task:
    print(f"TASK: {task}")
print(f"HANDOFF: {handoff}")
print(f"NEXT: Continue in the host prompt runtime from {handoff}.")
PYEOF
}

cmd_update() {
  local mode="${1:-}"
  local source="${2:-}"
  run_mnemos_update_check() {
    local diagnostics="${ASSET_ROOT}/scripts/crew-diagnostics.py"
    if [ -f "${diagnostics}" ]; then
      python3 "${diagnostics}" \
        --project-root "${PROJECT_ROOT}" \
        --asset-root "${ASSET_ROOT}" \
        --agent-crew-home "${AGENT_CREW_HOME}" \
        config dump --effective --format json 2>/dev/null \
        | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
    mnemos = data.get("mnemos") or {}
except Exception:
    sys.exit(0)
status = mnemos.get("status", "unknown")
detail = mnemos.get("detail", "")
print(f"update_check: mnemos={status} {detail}".rstrip())
' || true
    fi
  }

  case "${mode}" in
    -h|--help)
      cat <<'EOF'
usage: crew update [--local [SOURCE_ROOT]]

Default update mode clones origin/main into a fresh temporary checkout and
refreshes the install from that source. Use --local to deterministically refresh
from an existing local checkout.
EOF
      return 0
      ;;
    --local)
      local sync_script="${ASSET_ROOT}/scripts/sync-local-install.sh"
      require_file "${sync_script}" "local sync script"
      bash "${sync_script}" "${source:-${PROJECT_ROOT}}" "${PROJECT_ROOT}"
      run_mnemos_update_check
      ;;
    "")
      command -v git >/dev/null 2>&1 || die "git is required for native remote update"
      local update_total_start="${SECONDS}"
      local update_phase_start="${SECONDS}"
      local work_dir
      work_dir="$(mktemp -d)"
      git clone --depth 1 https://github.com/woogiekim/agent-crew "${work_dir}"
      printf 'update_phase: remote_clone=%sms\n' "$(( (SECONDS - update_phase_start) * 1000 ))"
      update_phase_start="${SECONDS}"
      local sync_script="${work_dir}/core/scripts/sync-local-install.sh"
      require_file "${sync_script}" "remote local sync script"
      bash "${sync_script}" "${work_dir}" "${PROJECT_ROOT}"
      printf 'update_phase: remote_sync=%sms\n' "$(( (SECONDS - update_phase_start) * 1000 ))"
      run_mnemos_update_check
      printf 'update_phase: remote_total=%sms\n' "$(( (SECONDS - update_total_start) * 1000 ))"
      ;;
    *)
      die "unknown update argument: ${mode}"
      ;;
  esac
}

cmd_run() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew run [--fake-host-result completed] [--host-bridge-command CMD] "task"

Creates deterministic local task state and a supervisor handoff. If no external
host bridge is configured, the run ends as STATUS: handoff_ready after writing
resumable state. Tests may use --fake-host-result completed to exercise the E2E
state path. Hosts may still set AGENT_CREW_HOST_BRIDGE_COMMAND, or pass
--host-bridge-command, to invoke an adapter bridge after handoff creation; a
zero exit status marks the run auto-completed with host bridge evidence.
EOF
    return 0
  fi
  sync_source_runtime_assets_if_drifted
  require_file "${ASSET_ROOT}/commands/run.md" "run command definition"
  sync_source_hooks_if_drifted
  local runtime="${ASSET_ROOT}/scripts/crew-runtime.py"
  require_file "${runtime}" "native runtime helper"
  python3 "${runtime}" run --project-root "${PROJECT_ROOT}" "$@"
}

cmd_repair() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew repair [--status completed|blocked|cancelled] [--note TEXT] [--evidence PATH]
                   [--quality-evidence PATH] [--quality-bypass-reason TEXT]
                   [--memory-id ID] TASK_ID

Records the result of a task that was continued manually from handoff.md in the
current host session. This updates local task state so telemetry stops reporting
stale host_bridge_not_invoked blockers after the fallback has completed.
Use --status cancelled when a handoff was intentionally superseded or aborted by
the user before implementation began.
For mutating implementation tasks, completed repairs require TDD/test evidence
and reviewer evidence unless an explicit quality bypass reason is recorded.
EOF
    return 0
  fi

  local repair="${ASSET_ROOT}/scripts/repair-task-state.py"
  sync_source_runtime_assets_if_drifted
  require_file "${repair}" "task repair script"
  python3 "${repair}" --state-dir "${STATE_DIR}" "$@"
}

cmd_cancel() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew cancel [--note TEXT] TASK_ID

Marks an intentionally superseded or user-aborted handoff as cancelled. This is
a concise operator-facing wrapper around `crew repair --status cancelled` so
stale handoff-ready work stops appearing as running without being mislabeled as
completed or blocked.
EOF
    return 0
  fi

  local note="cancelled by operator"
  local task_id=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --note)
        [ -n "${2:-}" ] || die "--note requires text"
        note="$2"
        shift 2
        ;;
      *)
        [ -z "${task_id}" ] || die "cancel accepts one TASK_ID"
        task_id="$1"
        shift
        ;;
    esac
  done
  [ -n "${task_id}" ] || die "cancel requires TASK_ID"

  cmd_repair --status cancelled --note "${note}" "${task_id}"
}

cmd_report() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew report auto [--format json|text|none] [--publish github]
       crew report publish [--format json|text|none] [--backend github]

Stores agent-crew bug/error reports in the native local report outbox. GitHub
publication is an optional backend, not part of the hook contract.
EOF
    return 0
  fi

  local reporter="${ASSET_ROOT}/scripts/auto-issue-reporter.py"
  require_file "${reporter}" "native report script"
  python3 "${reporter}" "$@"
}

cmd_issue_ingest() {
  local runtime="${ASSET_ROOT}/scripts/crew-runtime.py"
  require_file "${runtime}" "crew runtime"
  python3 "${runtime}" issue-ingest --project-root "${PROJECT_ROOT}" "$@"
}

cmd_cleanup_host_bridge() {
  local helper="${ASSET_ROOT}/scripts/crew-cli-cleanup.sh"
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    require_file "${helper}" "cleanup command helper"
    ASSET_ROOT="${ASSET_ROOT}" STATE_DIR="${STATE_DIR}" bash "${helper}" cleanup-host-bridge "$@"
    return
  fi
  sync_source_runtime_assets_if_drifted
  require_file "${helper}" "cleanup command helper"
  ASSET_ROOT="${ASSET_ROOT}" STATE_DIR="${STATE_DIR}" bash "${helper}" cleanup-host-bridge "$@"
}

cmd_cleanup_state() {
  local helper="${ASSET_ROOT}/scripts/crew-cli-cleanup.sh"
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    require_file "${helper}" "cleanup command helper"
    ASSET_ROOT="${ASSET_ROOT}" STATE_DIR="${STATE_DIR}" bash "${helper}" cleanup-state "$@"
    return
  fi
  sync_source_runtime_assets_if_drifted
  require_file "${helper}" "cleanup command helper"
  ASSET_ROOT="${ASSET_ROOT}" STATE_DIR="${STATE_DIR}" bash "${helper}" cleanup-state "$@"
}

cmd_agent() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew agent [--host-bridge-command CMD] [agent-name] [question]

Validates the direct-agent request and writes deterministic host handoff state.
The host prompt runtime still performs the actual read-only analysis.
Hosts may set AGENT_CREW_HOST_BRIDGE_COMMAND, or pass --host-bridge-command,
to execute a configured adapter bridge command after handoff creation.
If the bridge returns zero, command output is marked auto-completed.
EOF
    return 0
  fi
  require_file "${ASSET_ROOT}/commands/agent.md" "agent command definition"
  local runtime="${ASSET_ROOT}/scripts/crew-runtime.py"
  require_file "${runtime}" "native runtime helper"
  python3 "${runtime}" agent --project-root "${PROJECT_ROOT}" --asset-root "${ASSET_ROOT}" "$@"
}

main() {
  local command="${1:-help}"
  [ "$#" -gt 0 ] && shift || true

  case "${command}" in
    setup) cmd_setup "$@" ;;
    status) cmd_status "$@" ;;
    telemetry) cmd_telemetry "$@" ;;
    trace) cmd_trace "$@" ;;
    cost) cmd_cost "$@" ;;
    doctor) cmd_doctor "$@" ;;
    config) cmd_config "$@" ;;
    debug) cmd_debug "$@" ;;
    readiness) cmd_readiness "$@" ;;
    resume) cmd_resume "$@" ;;
    update) cmd_update "$@" ;;
    run) cmd_run "$@" ;;
    report) cmd_report "$@" ;;
    issue-ingest) cmd_issue_ingest "$@" ;;
    cancel) cmd_cancel "$@" ;;
    repair) cmd_repair "$@" ;;
    cleanup-host-bridge) cmd_cleanup_host_bridge "$@" ;;
    cleanup-state) cmd_cleanup_state "$@" ;;
    agent) cmd_agent "$@" ;;
    help|-h|--help) usage ;;
    *) die "unknown command: ${command}" ;;
  esac
}

main "$@"
