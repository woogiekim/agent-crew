#!/usr/bin/env bash
# crew - deterministic shell entrypoint for agent-crew.

set -euo pipefail

AGENT_CREW_HOME="${AGENT_CREW_HOME:-${HOME}/.agent-crew}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -d "${SCRIPT_DIR}/../commands" ] && [ -d "${SCRIPT_DIR}/../scripts" ]; then
  ASSET_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
else
  ASSET_ROOT="${AGENT_CREW_HOME}"
fi

SOURCE_ROOT="${ASSET_ROOT}"
if [ -d "${ASSET_ROOT}/../adapters" ] && [ "$(basename "${ASSET_ROOT}")" = "core" ]; then
  SOURCE_ROOT="$(cd "${ASSET_ROOT}/.." && pwd)"
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
PROJECT_ROOT="${PROJECT_ROOT:-${REPO_ROOT}}"
if [ -f "${ASSET_ROOT}/scripts/project-state.sh" ]; then
  # shellcheck source=/dev/null
  . "${ASSET_ROOT}/scripts/project-state.sh"
elif [ -f "${AGENT_CREW_HOME}/scripts/project-state.sh" ]; then
  # shellcheck source=/dev/null
  . "${AGENT_CREW_HOME}/scripts/project-state.sh"
fi
if declare -F project_state_load >/dev/null 2>&1; then
  project_state_load \
    --agent-crew-home "${AGENT_CREW_HOME}" \
    --project-root "${PROJECT_ROOT}" \
    --prefer-existing-legacy
else
  PROJECT_NAME="$(basename "${PROJECT_ROOT}")"
  PROJECT_STATE_KEY="${PROJECT_NAME}"
  STATE_DIR="${AGENT_CREW_HOME}/state/${PROJECT_NAME}"
fi

usage() {
  cat <<'EOF'
usage: crew <command> [args]

agent-crew is a local control plane for AI-host prompt workflows. The host AI
remains the execution plane; crew provides setup, state, handoff, audit, and
adapter-sync helpers around that prompt runtime.

Commands:
  setup [PROJECT_ROOT]             Install/refresh host adapter for a project
  status [--json|--summary] [--recent N]
                                    Show deterministic local task state
  telemetry [args]                 Show timing, retry, blocker, and token metrics
  trace [args]                     Show per-task progress trace events
  cost [args]                      Show token/cost aggregate metrics
  doctor [args]                    Run framework operational readiness checks
  config doctor|dump [args]        Show effective configuration and drift
  debug [args]                     Run doctor + recent telemetry + cost snapshot
  readiness evidence|metrics|gate|workload [args]
                                    Generate readiness evidence, metrics, or gate report
  question key|record|resolve|render-markdown [args]
                                    Persist structured question choices
  resume [--print|--dry-run] TASK_ID
                                    Request or print deterministic resume state
  update [--local [SOURCE_ROOT]] [--all-projects]
                                    Refresh installed assets
  run "task"                       Write state and host handoff for a task
  report auto|publish|cleanup [args]
                                    Store/publish/cleanup native agent-crew reports
  issue-ingest ISSUE [args]        Record issue body/comment ingestion evidence
  cancel [--note TEXT] TASK_ID     Mark a superseded handoff as cancelled
  repair [args] TASK_ID            Repair a manually completed handoff task
  cleanup-host-bridge [args]       Bulk repair stale host bridge blockers
  cleanup-state [args]             Dry-run task-state cleanup/archive plan
  agent [name] [question]          Write direct-agent host handoff state
  help                             Show this help

Notes:
  crew setup/status/update and the crew run/agent state transitions are native
  shell paths. The host runtime such as Codex or Claude still performs execution.
EOF
}

die() {
  printf 'crew: %s\n' "$*" >&2
  exit 2
}

require_file() {
  local path="$1" label="$2"
  [ -f "${path}" ] || die "${label} not found at ${path}; install agent-crew first"
}

find_source_checkout() {
  local source
  for source in "${AGENT_CREW_SOURCE_DIR:-}" "${PROJECT_ROOT}" "${SOURCE_ROOT}"; do
    [ -n "${source}" ] || continue
    if [ -d "${source}/core" ] && [ -d "${source}/adapters" ]; then
      (cd "${source}" && pwd)
      return 0
    fi
  done
  return 1
}

copy_flat_assets() {
  local src="$1" dest="$2" pattern="$3"
  [ -d "${src}" ] || return 0
  mkdir -p "${dest}"
  # shellcheck disable=SC2086
  cp -f "${src}"/${pattern} "${dest}/" 2>/dev/null || true
}

copy_tree_assets() {
  local src="$1" dest="$2"
  [ -d "${src}" ] || return 0
  mkdir -p "${dest}"
  cp -rf "${src}/." "${dest}/"
}

absolute_file_path() {
  local path="$1" dir base
  [ -n "${path}" ] || return 1
  case "${path}" in
    /*) ;;
    *) path="$(pwd)/${path}" ;;
  esac
  dir="$(dirname "${path}")"
  base="$(basename "${path}")"
  [ -d "${dir}" ] || return 1
  printf '%s/%s\n' "$(cd "${dir}" && pwd)" "${base}"
}

is_managed_crew_cli() {
  local path="$1"
  [ -f "${path}" ] || return 1
  grep -q "experimental Codex launcher for agent-crew\\|deterministic shell entrypoint for agent-crew" "${path}" 2>/dev/null
}

sync_managed_path_crew_cli() {
  local source_crew="$1" candidate resolved
  [ -f "${source_crew}" ] || return 0

  for candidate in \
    "${BASH_SOURCE[0]:-}" \
    "$(command -v crew 2>/dev/null || true)" \
    "${AGENT_CREW_PATH_BIN:-${HOME}/.local/bin}/crew"; do
    resolved="$(absolute_file_path "${candidate}" 2>/dev/null || true)"
    [ -n "${resolved}" ] || continue
    [ -f "${resolved}" ] || continue
    is_managed_crew_cli "${resolved}" || continue
    cmp -s "${source_crew}" "${resolved}" 2>/dev/null && continue
    cp -f "${source_crew}" "${resolved}"
    chmod +x "${resolved}"
  done
}

sync_source_runtime_assets_if_drifted() {
  [ "${AGENT_CREW_AUTO_SYNC_RUNTIME_ON_RUN:-1}" = "1" ] || return 0

  local source
  source="$(find_source_checkout 2>/dev/null || true)"
  [ -n "${source}" ] || return 0

  local drift=0 check
  for check in \
    "core/bin/crew:${AGENT_CREW_HOME}/bin/crew" \
    "core/scripts/crew-runtime.py:${AGENT_CREW_HOME}/scripts/crew-runtime.py" \
    "core/scripts/project_state.py:${AGENT_CREW_HOME}/scripts/project_state.py" \
    "core/scripts/project-state.sh:${AGENT_CREW_HOME}/scripts/project-state.sh" \
    "core/scripts/crew-diagnostics.py:${AGENT_CREW_HOME}/scripts/crew-diagnostics.py" \
    "core/scripts/repair-task-state.py:${AGENT_CREW_HOME}/scripts/repair-task-state.py" \
    "core/scripts/pipeline-quality-plan-check.py:${AGENT_CREW_HOME}/scripts/pipeline-quality-plan-check.py" \
    "core/scripts/quality-loop-check.py:${AGENT_CREW_HOME}/scripts/quality-loop-check.py" \
    "core/scripts/quality_loop_lib.py:${AGENT_CREW_HOME}/scripts/quality_loop_lib.py" \
    "core/scripts/reviewer-loop-decision.py:${AGENT_CREW_HOME}/scripts/reviewer-loop-decision.py" \
    "core/scripts/cleanup-host-bridge-blockers.py:${AGENT_CREW_HOME}/scripts/cleanup-host-bridge-blockers.py" \
    "core/scripts/cleanup-task-state.py:${AGENT_CREW_HOME}/scripts/cleanup-task-state.py" \
    "core/scripts/core_objective_lib.py:${AGENT_CREW_HOME}/scripts/core_objective_lib.py" \
    "core/scripts/codex-workflow-guard.py:${AGENT_CREW_HOME}/scripts/codex-workflow-guard.py" \
    "core/scripts/crew-cli-cleanup.sh:${AGENT_CREW_HOME}/scripts/crew-cli-cleanup.sh" \
    "core/scripts/cost-aggregate.py:${AGENT_CREW_HOME}/scripts/cost-aggregate.py" \
    "core/scripts/memory-gc.py:${AGENT_CREW_HOME}/scripts/memory-gc.py" \
    "core/scripts/framework-review-check.py:${AGENT_CREW_HOME}/scripts/framework-review-check.py" \
    "core/scripts/agent-capability-check.py:${AGENT_CREW_HOME}/scripts/agent-capability-check.py" \
    "core/scripts/pipeline-capability-check.py:${AGENT_CREW_HOME}/scripts/pipeline-capability-check.py" \
    "core/scripts/workflow-replay-check.py:${AGENT_CREW_HOME}/scripts/workflow-replay-check.py" \
    "core/scripts/retry-chaos-check.py:${AGENT_CREW_HOME}/scripts/retry-chaos-check.py" \
    "core/scripts/telemetry-taxonomy-check.py:${AGENT_CREW_HOME}/scripts/telemetry-taxonomy-check.py" \
    "core/scripts/auto-issue-reporter.py:${AGENT_CREW_HOME}/scripts/auto-issue-reporter.py" \
    "core/scripts/e2e-slo-check.py:${AGENT_CREW_HOME}/scripts/e2e-slo-check.py" \
    "core/scripts/update-slo-benchmark.py:${AGENT_CREW_HOME}/scripts/update-slo-benchmark.py" \
    "core/scripts/generate-release-checksums.py:${AGENT_CREW_HOME}/scripts/generate-release-checksums.py" \
    "core/scripts/readiness-metrics.py:${AGENT_CREW_HOME}/scripts/readiness-metrics.py" \
    "core/scripts/readiness-gate.py:${AGENT_CREW_HOME}/scripts/readiness-gate.py" \
    "core/scripts/readiness-workload-validate.py:${AGENT_CREW_HOME}/scripts/readiness-workload-validate.py" \
    "core/scripts/hosted-workload-evidence.py:${AGENT_CREW_HOME}/scripts/hosted-workload-evidence.py" \
    "core/scripts/interactive-question-state.py:${AGENT_CREW_HOME}/scripts/interactive-question-state.py" \
    "core/scripts/check-host-bridge.py:${AGENT_CREW_HOME}/scripts/check-host-bridge.py" \
    "core/scripts/verify-install-drift.py:${AGENT_CREW_HOME}/scripts/verify-install-drift.py" \
    "core/scripts/update-project-registry.py:${AGENT_CREW_HOME}/scripts/update-project-registry.py" \
    "core/commands/run.md:${AGENT_CREW_HOME}/commands/run.md" \
    "core/rules/prompt-injection-defense.md:${AGENT_CREW_HOME}/rules/prompt-injection-defense.md" \
    "core/evaluations/memory-retrieval.json:${AGENT_CREW_HOME}/evaluations/memory-retrieval.json" \
    "core/evaluations/workflow-replay.json:${AGENT_CREW_HOME}/evaluations/workflow-replay.json" \
    "core/evaluations/retry-chaos.json:${AGENT_CREW_HOME}/evaluations/retry-chaos.json" \
    "core/policies/agent-capabilities.json:${AGENT_CREW_HOME}/policies/agent-capabilities.json" \
    "core/schemas/agent-capabilities.schema.json:${AGENT_CREW_HOME}/schemas/agent-capabilities.schema.json"; do
    local src_rel="${check%%:*}" dest="${check#*:}"
    if [ -f "${source}/${src_rel}" ] && ! cmp -s "${source}/${src_rel}" "${dest}" 2>/dev/null; then
      drift=1
      break
    fi
  done
  [ "${drift}" = "1" ] || return 0

  copy_flat_assets "${source}/core/commands" "${AGENT_CREW_HOME}/system/commands" "*.md"
  copy_flat_assets "${source}/core/commands" "${AGENT_CREW_HOME}/commands" "*.md"
  copy_tree_assets "${source}/core/rules" "${AGENT_CREW_HOME}/system/rules"
  copy_tree_assets "${source}/core/rules" "${AGENT_CREW_HOME}/rules"
  copy_flat_assets "${source}/core/hooks" "${AGENT_CREW_HOME}/system/hooks" "*.sh"
  copy_flat_assets "${source}/core/hooks" "${AGENT_CREW_HOME}/hooks" "*.sh"
  copy_tree_assets "${source}/core/scripts" "${AGENT_CREW_HOME}/system/scripts"
  copy_tree_assets "${source}/core/scripts" "${AGENT_CREW_HOME}/scripts"
  copy_tree_assets "${source}/core/evaluations" "${AGENT_CREW_HOME}/system/evaluations"
  copy_tree_assets "${source}/core/evaluations" "${AGENT_CREW_HOME}/evaluations"
  copy_tree_assets "${source}/core/policies" "${AGENT_CREW_HOME}/system/policies"
  copy_tree_assets "${source}/core/policies" "${AGENT_CREW_HOME}/policies"
  copy_flat_assets "${source}/core/bin" "${AGENT_CREW_HOME}/bin" "*"
  sync_managed_path_crew_cli "${source}/core/bin/crew"
  copy_flat_assets "${source}/core/schemas" "${AGENT_CREW_HOME}/system/schemas" "*.json"
  copy_flat_assets "${source}/core/schemas" "${AGENT_CREW_HOME}/schemas" "*.json"
  chmod +x \
    "${AGENT_CREW_HOME}/system/hooks/"*.sh "${AGENT_CREW_HOME}/hooks/"*.sh \
    "${AGENT_CREW_HOME}/system/scripts/"*.sh "${AGENT_CREW_HOME}/scripts/"*.sh \
    "${AGENT_CREW_HOME}/system/scripts/"*.py "${AGENT_CREW_HOME}/scripts/"*.py \
    "${AGENT_CREW_HOME}/bin/"* \
    2>/dev/null || true

  printf 'crew: refreshed runtime assets from source checkout because installed assets drifted\n' >&2
}

sync_source_hooks_if_drifted() {
  [ "${AGENT_CREW_AUTO_SYNC_HOOKS_ON_RUN:-1}" = "1" ] || return 0

  local source source_hooks=""
  source="$(find_source_checkout 2>/dev/null || true)"
  [ -n "${source}" ] && source_hooks="${source}/core/hooks"
  [ -n "${source_hooks}" ] || return 0

  local drift=0 hook base dest
  for hook in "${source_hooks}"/*.sh; do
    [ -f "${hook}" ] || continue
    base="$(basename "${hook}")"
    for dest in "${AGENT_CREW_HOME}/system/hooks/${base}" "${AGENT_CREW_HOME}/hooks/${base}"; do
      if ! cmp -s "${hook}" "${dest}" 2>/dev/null; then
        drift=1
        break 2
      fi
    done
    if [ -d "${PROJECT_ROOT}/.agent-crew/hooks" ] \
      && ! cmp -s "${hook}" "${PROJECT_ROOT}/.agent-crew/hooks/${base}" 2>/dev/null; then
      drift=1
      break
    fi
    if [ -d "${PROJECT_ROOT}/.codex/hooks" ] \
      && ! cmp -s "${hook}" "${PROJECT_ROOT}/.codex/hooks/${base}" 2>/dev/null; then
      drift=1
      break
    fi
  done
  [ "${drift}" = "1" ] || return 0

  mkdir -p "${AGENT_CREW_HOME}/system/hooks" "${AGENT_CREW_HOME}/hooks"
  cp -f "${source_hooks}/"*.sh "${AGENT_CREW_HOME}/system/hooks/" 2>/dev/null || true
  cp -f "${source_hooks}/"*.sh "${AGENT_CREW_HOME}/hooks/" 2>/dev/null || true
  chmod +x "${AGENT_CREW_HOME}/system/hooks/"*.sh "${AGENT_CREW_HOME}/hooks/"*.sh 2>/dev/null || true

  if [ -d "${PROJECT_ROOT}/.agent-crew/hooks" ]; then
    cp -f "${source_hooks}/"*.sh "${PROJECT_ROOT}/.agent-crew/hooks/" 2>/dev/null || true
    chmod +x "${PROJECT_ROOT}/.agent-crew/hooks/"*.sh 2>/dev/null || true
  fi
  if [ -d "${PROJECT_ROOT}/.codex/hooks" ]; then
    cp -f "${source_hooks}/"*.sh "${PROJECT_ROOT}/.codex/hooks/" 2>/dev/null || true
    chmod +x "${PROJECT_ROOT}/.codex/hooks/"*.sh 2>/dev/null || true
  fi

  printf 'crew: refreshed auto-route hooks from source checkout because installed hooks drifted\n' >&2
}

setup_existing_state_action() {
  local action="${AGENT_CREW_SETUP_EXISTING_STATE_ACTION:-}"
  if [ -n "${action}" ]; then
    printf '%s\n' "${action}"
    return 0
  fi

  if [ ! -t 0 ]; then
    printf 'preserve-context\n'
    return 0
  fi

  cat <<'EOF'
Existing agent-crew project state was found.

  1) Cancel setup
  2) Reset task/runtime state, preserve project-context (default)
  3) Archive project-context, then reset task/runtime state
  4) Full state reset
EOF
  printf 'Choose [2]: ' >&2
  local choice
  read -r choice || choice=""
  case "${choice:-2}" in
    1|c|C|cancel) printf 'cancel\n' ;;
    2|p|P|preserve|preserve-context) printf 'preserve-context\n' ;;
    3|a|A|archive|archive-context) printf 'archive-context\n' ;;
    4|f|F|full|full-reset) printf 'full-reset\n' ;;
    *) printf 'preserve-context\n' ;;
  esac
}

prepare_setup_state() {
  local project="$1"
  declare -F project_state_load >/dev/null 2>&1 || return 0

  project_state_load \
    --agent-crew-home "${AGENT_CREW_HOME}" \
    --project-root "${project}" \
    --prefer-existing-legacy

  if [ ! -d "${STATE_DIR}" ] && { [ -z "${LEGACY_STATE_DIR:-}" ] || [ ! -d "${LEGACY_STATE_DIR}" ]; }; then
    project_state_load \
      --agent-crew-home "${AGENT_CREW_HOME}" \
      --project-root "${project}" \
      --ensure \
      --migrate-legacy
    return 0
  fi

  local action setup_result_rc setup_exports
  action="$(setup_existing_state_action)"
  setup_result_rc=0
  setup_exports="$(project_state_setup_existing \
    --agent-crew-home "${AGENT_CREW_HOME}" \
    --project-root "${project}" \
    --action "${action}")" || setup_result_rc=$?
  [ -n "${setup_exports}" ] && eval "${setup_exports}"

  if [ "${setup_result_rc}" = "10" ] || [ "${AGENT_CREW_SETUP_CANCELLED:-0}" = "1" ]; then
    printf 'crew setup: cancelled; existing state was left unchanged.\n'
    return 10
  fi
  if [ "${setup_result_rc}" != "0" ]; then
    return "${setup_result_rc}"
  fi
}

cmd_setup() {
  local project="${1:-${PROJECT_ROOT}}"
  local setup_script="${ASSET_ROOT}/setup/setup-host.sh"
  local install_setup="${AGENT_CREW_HOME}/setup/setup-host.sh"

  prepare_setup_state "${project}" || {
    local rc=$?
    [ "${rc}" = "10" ] && return 0
    return "${rc}"
  }

  if [ ! -x "${install_setup}" ] && [ "${ASSET_ROOT}" != "${AGENT_CREW_HOME}" ]; then
    local sync_script="${ASSET_ROOT}/scripts/sync-local-install.sh"
    require_file "${sync_script}" "local sync script"
    bash "${sync_script}" "${SOURCE_ROOT}" "${project}"
    return
  fi

  require_file "${setup_script}" "setup dispatcher"
  bash "${setup_script}" "${project}"
  record_project_update_scope "${project}" "${SOURCE_ROOT}"
}

update_registry_script() {
  local candidate
  for candidate in \
    "${ASSET_ROOT}/scripts/update-project-registry.py" \
    "${AGENT_CREW_HOME}/system/scripts/update-project-registry.py" \
    "${AGENT_CREW_HOME}/scripts/update-project-registry.py"; do
    [ -f "${candidate}" ] || continue
    printf '%s\n' "${candidate}"
    return 0
  done
  return 1
}

record_project_update_scope() {
  local project="$1"
  local source="$2"
  local registry
  registry="$(update_registry_script 2>/dev/null || true)"
  [ -n "${registry}" ] || return 0
  python3 "${registry}" \
    --agent-crew-home "${AGENT_CREW_HOME}" \
    mark-project \
    --source-root "${source}" \
    --project-root "${project}" >/dev/null 2>&1 || true
}

print_update_stale_warning() {
  local registry
  registry="$(update_registry_script 2>/dev/null || true)"
  [ -n "${registry}" ] || return 0
  python3 "${registry}" \
    --agent-crew-home "${AGENT_CREW_HOME}" \
    check-stale \
    --project-root "${PROJECT_ROOT}" \
    --format text || true
}

update_registered_projects() {
  local source="$1"
  local current="$2"
  local registry setup_script roots_file current_resolved project project_resolved
  local total=0 refreshed=0 skipped=0 current_seen=0

  registry="$(update_registry_script 2>/dev/null || true)"
  [ -n "${registry}" ] || {
    printf 'update_scope: all_projects=skipped reason=registry_script_missing\n'
    return 0
  }

  setup_script="${AGENT_CREW_HOME}/system/setup/setup-host.sh"
  [ -x "${setup_script}" ] || setup_script="${AGENT_CREW_HOME}/setup/setup-host.sh"
  [ -x "${setup_script}" ] || {
    printf 'update_scope: all_projects=skipped reason=setup_dispatcher_missing\n'
    return 0
  }

  roots_file="$(mktemp)"
  python3 "${registry}" \
    --agent-crew-home "${AGENT_CREW_HOME}" \
    list-projects > "${roots_file}" || true

  current_resolved="$(cd "${current}" 2>/dev/null && pwd || printf '%s' "${current}")"
  while IFS= read -r project; do
    [ -n "${project}" ] || continue
    total=$((total + 1))
    if [ ! -d "${project}" ]; then
      printf 'update_scope: project=%s status=skipped reason=missing_path\n' "${project}"
      skipped=$((skipped + 1))
      continue
    fi

    project_resolved="$(cd "${project}" 2>/dev/null && pwd || printf '%s' "${project}")"
    if [ "${project_resolved}" = "${current_resolved}" ]; then
      printf 'update_scope: project=%s status=already-refreshed\n' "${project_resolved}"
      current_seen=1
      continue
    fi

    printf 'update_scope: project=%s status=refreshing\n' "${project_resolved}"
    SOURCE_ROOT="${source}" AGENT_CREW_MODE=update \
      bash "${setup_script}" "${project_resolved}"
    python3 "${registry}" \
      --agent-crew-home "${AGENT_CREW_HOME}" \
      mark-project \
      --source-root "${source}" \
      --project-root "${project_resolved}" >/dev/null 2>&1 || true
    refreshed=$((refreshed + 1))
  done < "${roots_file}"
  rm -f "${roots_file}"

  if [ "${current_seen}" = "0" ]; then
    printf 'update_scope: project=%s status=already-refreshed\n' "${current_resolved}"
  fi
  printf 'update_scope: all_projects total=%s refreshed=%s skipped=%s\n' \
    "${total}" "${refreshed}" "${skipped}"
}

cmd_status_json() {
  local recent="${1:-10}"
  local telemetry="${ASSET_ROOT}/scripts/telemetry-aggregate.py"
  if [ -f "${telemetry}" ]; then
    if grep -q -- "--project-root" "${telemetry}" 2>/dev/null; then
      python3 "${telemetry}" --state-dir "${STATE_DIR}" --project-root "${PROJECT_ROOT}" --recent "${recent}" --format json
    else
      python3 "${telemetry}" --state-dir "${STATE_DIR}" --recent "${recent}" --format json
    fi
    return
  fi
  printf '{"project":"%s","state_dir":"%s","error":"telemetry script not found"}\n' \
    "${PROJECT_NAME}" "${STATE_DIR}"
}

cmd_status_summary() {
  local recent="$1"
  local telemetry="${ASSET_ROOT}/scripts/telemetry-aggregate.py"

  printf 'Project: %s\n' "${PROJECT_NAME}"
  printf 'State  : %s\n' "${STATE_DIR}"

  if [ ! -d "${STATE_DIR}/tasks" ]; then
    printf 'Tasks  : 0 total\n'
    printf 'Next   : crew setup, then use crew:run in your host runtime.\n'
    return 0
  fi

  if [ ! -f "${telemetry}" ]; then
    printf 'Tasks  : telemetry unavailable\n'
    printf 'Next   : rerun crew status for raw task directories.\n'
    return 0
  fi

  local tmp
  tmp="$(mktemp)"
  if grep -q -- "--project-root" "${telemetry}" 2>/dev/null; then
    python3 "${telemetry}" --state-dir "${STATE_DIR}" --project-root "${PROJECT_ROOT}" --recent "${recent}" --format json > "${tmp}"
  else
    python3 "${telemetry}" --state-dir "${STATE_DIR}" --recent "${recent}" --format json > "${tmp}"
  fi

  python3 - "${tmp}" "${recent}" <<'PYEOF'
import json
import sys

path, recent = sys.argv[1], sys.argv[2]
with open(path, "r", encoding="utf-8") as f:
    payload = json.load(f)

summary = payload.get("summary", {})
tasks = payload.get("tasks", [])
quality = summary.get("operational_quality", {})

def pct(value):
    try:
        return f"{float(value) * 100:.1f}%"
    except Exception:
        return "n/a"

total = summary.get("tasks_total", len(tasks))
completed = summary.get("tasks_completed", 0)
running = summary.get("tasks_running", 0)
blocked = summary.get("tasks_blocked", 0)
cancelled = summary.get("tasks_cancelled", 0)

print(f"Tasks  : {total} total | {completed} completed | {running} running | {blocked} blocked | {cancelled} cancelled")
print(
    "Quality: "
    f"success={pct(quality.get('success_rate'))} | "
    f"retry={pct(quality.get('retry_rate'))} | "
    f"intervention={pct(quality.get('human_intervention_rate'))}"
)

bridge = summary.get("by_host_bridge_status") or {}
bridge_text = ", ".join(f"{key}={value}" for key, value in bridge.items()) or "none"
print(f"Bridge : {bridge_text}")

blocked_tasks = [
    task for task in tasks
    if str(task.get("health") or task.get("status") or "").lower() == "blocked"
       or task.get("blockers")
]
if blocked_tasks:
    first = blocked_tasks[0]
    guidance = first.get("guidance") or ["Inspect result.md and progress.log."]
    print(f"Next   : {first.get('task_id')}: {guidance[0]}")
else:
    print("Next   : none")

print(f"Detail : crew status --recent {recent}")
print(f"JSON   : crew status --json --recent {recent}")
PYEOF
  rm -f "${tmp}"
}

cmd_status() {
  local format="text"
  local recent="10"
  local summary="0"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json) format="json"; shift ;;
      --summary) summary="1"; shift ;;
      --recent)
        [ -n "${2:-}" ] || die "--recent requires a number"
        recent="$2"
        shift 2
        ;;
      -h|--help)
        cat <<'EOF'
usage: crew status [--json|--summary] [--recent N]

Reads ~/.agent-crew/state/<project>/ and prints local task telemetry.

Use --summary for a compact operator view. Use --json for tools.
EOF
        return 0
        ;;
      *) die "unknown status argument: $1" ;;
    esac
  done

  if [ "${format}" = "json" ]; then
    cmd_status_json "${recent}"
    return
  fi

  if [ "${summary}" = "1" ]; then
    cmd_status_summary "${recent}"
    return
  fi

  printf 'Project: %s\n' "${PROJECT_NAME}"
  printf 'State  : %s\n\n' "${STATE_DIR}"
  print_update_stale_warning

  if [ ! -d "${STATE_DIR}/tasks" ]; then
    printf 'No tasks found. Run crew setup first, then use crew:run in your host runtime.\n'
    return 0
  fi

  local telemetry="${ASSET_ROOT}/scripts/telemetry-aggregate.py"
  if [ -f "${telemetry}" ]; then
    if grep -q -- "--project-root" "${telemetry}" 2>/dev/null; then
      python3 "${telemetry}" --state-dir "${STATE_DIR}" --project-root "${PROJECT_ROOT}" --recent "${recent}" --format text
    else
      python3 "${telemetry}" --state-dir "${STATE_DIR}" --recent "${recent}" --format text
    fi
  else
    find "${STATE_DIR}/tasks" -mindepth 1 -maxdepth 1 -type d | sort | tail -"${recent}"
  fi
}

cmd_telemetry() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew telemetry [--task-id ID] [--session-id ID] [--recent N] [--format text|json]

Reads ~/.agent-crew/state/<project>/ and prints pipeline timing, retry,
blocker, and token telemetry.
EOF
    return 0
  fi

  local telemetry="${ASSET_ROOT}/scripts/telemetry-aggregate.py"
  require_file "${telemetry}" "telemetry aggregator"

  if [ ! -d "${STATE_DIR}/tasks" ]; then
    printf 'No tasks found. Run crew setup first, then use crew run in your host runtime.\n'
    return 0
  fi

  if grep -q -- "--project-root" "${telemetry}" 2>/dev/null; then
    python3 "${telemetry}" --state-dir "${STATE_DIR}" --project-root "${PROJECT_ROOT}" "$@"
  else
    python3 "${telemetry}" --state-dir "${STATE_DIR}" "$@"
  fi
}

cmd_trace() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew trace [--task-id ID] [--recent N] [--format text|json] [--include-tools]

Prints structured progress events from progress.buffer.jsonl, falling back to
progress.log for pre-trace task state. With --include-tools, also prints
tool-events.jsonl entries keyed by trace_id. Read-only.
EOF
    return 0
  fi

  local task_id=""
  local recent="1"
  local format="text"
  local include_tools="0"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --task-id)
        [ -n "${2:-}" ] || die "--task-id requires an id"
        task_id="$2"
        shift 2
        ;;
      --recent)
        [ -n "${2:-}" ] || die "--recent requires a number"
        recent="$2"
        shift 2
        ;;
      --format)
        [ -n "${2:-}" ] || die "--format requires text or json"
        format="$2"
        shift 2
        ;;
      --include-tools) include_tools="1"; shift ;;
      *) die "unknown trace argument: $1" ;;
    esac
  done
  case "${format}" in text|json) ;; *) die "--format must be text or json" ;; esac

  python3 - "${STATE_DIR}" "${task_id}" "${recent}" "${format}" "${include_tools}" <<'PYEOF'
import json, sys
from pathlib import Path

state_dir = Path(sys.argv[1])
task_id = sys.argv[2]
try:
    recent = max(1, int(sys.argv[3]))
except Exception:
    recent = 1
fmt = sys.argv[4]
include_tools = sys.argv[5] == "1"
tasks_root = state_dir / "tasks"

def task_dirs():
    if not tasks_root.is_dir():
        return []
    if task_id:
        p = tasks_root / task_id
        return [p] if p.is_dir() else []
    dirs = [p for p in tasks_root.iterdir() if p.is_dir()]
    dirs.sort(key=lambda p: p.stat().st_mtime, reverse=True)
    return dirs[:recent]

def read_buffer(path):
    rows = []
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            row = json.loads(line)
        except Exception:
            continue
        rows.append({
            "ts": row.get("ts", ""),
            "task_id": row.get("task_id", ""),
            "trace_id": row.get("trace_id", ""),
            "event": row.get("event", ""),
            "stage": row.get("stage", 0),
            "agent": row.get("agent", ""),
            "attempt": row.get("attempt", 0),
            "status": row.get("status", ""),
            "detail": row.get("detail", ""),
        })
    return rows

def read_log(path, tid):
    rows = []
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        parts = [p.strip() for p in line.split("|", 2)]
        if len(parts) == 3:
            ts, event, detail = parts
        else:
            ts, event, detail = "", "LOG", line.strip()
        rows.append({
            "ts": ts,
            "task_id": tid,
            "trace_id": "",
            "event": event,
            "stage": 0,
            "agent": "",
            "attempt": 0,
            "status": "",
            "detail": detail,
        })
    return rows

def read_tool_events(path):
    rows = []
    if not path.is_file():
        return rows
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            row = json.loads(line)
        except Exception:
            continue
        rows.append({
            "trace_id": row.get("trace_id", ""),
            "tool_name": row.get("tool_name", ""),
            "action_summary": row.get("action_summary", ""),
            "started_at": row.get("started_at", ""),
            "ended_at": row.get("ended_at", ""),
            "status": row.get("status", ""),
            "exit_code": row.get("exit_code"),
            "token_usage_ref": row.get("token_usage_ref", ""),
            "failure_class": row.get("failure_class", ""),
        })
    return rows

payload = []
for td in task_dirs():
    buffer = td / "progress.buffer.jsonl"
    log = td / "progress.log"
    rows = read_buffer(buffer) if buffer.is_file() else (read_log(log, td.name) if log.is_file() else [])
    item = {"task_id": td.name, "task_dir": str(td), "events": rows}
    if include_tools:
        item["tools"] = read_tool_events(td / "tool-events.jsonl")
    payload.append(item)

if fmt == "json":
    print(json.dumps({"state_dir": str(state_dir), "tasks": payload}, ensure_ascii=False, indent=2))
else:
    if not payload:
        print("No trace events found.")
    for item in payload:
        print(f"Task: {item['task_id']}")
        print(f"Dir : {item['task_dir']}")
        if not item["events"]:
            print("  (no events)")
            continue
        for row in item["events"]:
            trace = f" trace={row['trace_id']}" if row["trace_id"] else ""
            agent = f" agent={row['agent']}" if row["agent"] else ""
            print(f"  {row['ts']} {row['event']} status={row['status']} stage={row['stage']} attempt={row['attempt']}{agent}{trace} | {row['detail']}")
        if include_tools:
            tools = item.get("tools", [])
            print("  Tools:")
            if not tools:
                print("    (no tool events)")
            for row in tools:
                exit_part = "" if row["exit_code"] is None else f" exit={row['exit_code']}"
                failure = f" failure={row['failure_class']}" if row["failure_class"] else ""
                print(f"    {row['started_at']} {row['tool_name']} status={row['status']}{exit_part}{failure} trace={row['trace_id']} | {row['action_summary']}")
PYEOF
}

