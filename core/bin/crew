cmd_debug() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew debug [--recent N]

Runs read-only operator diagnostics: doctor, recent telemetry, and recent cost
summary. It never mutates workflow state.
EOF
    return 0
  fi

  local recent="5"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --recent)
        [ -n "${2:-}" ] || die "--recent requires a number"
        recent="$2"
        shift 2
        ;;
      *) die "unknown debug argument: $1" ;;
    esac
  done

  printf '== doctor ==\n'
  cmd_doctor || true
  printf '\n== telemetry ==\n'
  cmd_telemetry --recent "${recent}" || true
  printf '\n== cost ==\n'
  cmd_cost --recent "${recent}" --format table || true
}

cmd_readiness() {
  local sub="${1:-}"
  shift || true

  case "${sub}" in
    evidence)
      local helper="${ASSET_ROOT}/scripts/hosted-workload-evidence.py"
      require_file "${helper}" "hosted workload evidence helper"
      python3 "${helper}" --state-dir "${STATE_DIR}" "$@"
      ;;
    metrics)
      local helper="${ASSET_ROOT}/scripts/readiness-metrics.py"
      require_file "${helper}" "readiness metrics helper"
      python3 "${helper}" "$@"
      ;;
    gate)
      local helper="${ASSET_ROOT}/scripts/readiness-gate.py"
      require_file "${helper}" "readiness gate helper"
      python3 "${helper}" --state-dir "${STATE_DIR}" "$@"
      ;;
    workload)
      local helper="${ASSET_ROOT}/scripts/readiness-workload-validate.py"
      require_file "${helper}" "readiness workload validation helper"
      python3 "${helper}" --crew-bin "${ASSET_ROOT}/bin/crew" "$@"
      ;;
    -h|--help|"")
      cat <<'EOF'
usage: crew readiness evidence [--recent N] [--include-agent-requests] [--output PATH] [--format text|json]
       crew readiness metrics [readiness-metrics.py args]
       crew readiness gate [--validation-report PATH] [--include-agent-requests] [readiness-gate.py args]
       crew readiness workload [--output PATH] [--format text|json]

Generate local workload evidence from agent-crew task state, then feed that
evidence into commercial readiness metric aggregation, a default-threshold
readiness gate with blocker reporting, or an explicit deterministic validation
workload evidence file.
EOF
      ;;
    *)
      die "unknown readiness subcommand: ${sub}"
      ;;
  esac
}

