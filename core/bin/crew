cmd_resume() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew resume [--print|--dry-run] TASK_ID

Default mode records a RESUME_REQUESTED state event, then prints deterministic
resume coordinates for the host prompt runtime. --print and --dry-run preserve
the read-only behavior.
EOF
    return 0
  fi

  local task_id="" mode="request"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --print|--dry-run) mode="print"; shift ;;
      *)
        [ -z "${task_id}" ] || die "resume accepts one TASK_ID"
        task_id="$1"
        shift
        ;;
    esac
  done
  python3 - "${STATE_DIR}" "${task_id}" "${mode}" <<'PYEOF'
import json, re, sys
from datetime import datetime, timezone
from pathlib import Path

state_dir = Path(sys.argv[1])
requested = sys.argv[2]
mode = sys.argv[3]
tasks_root = state_dir / "tasks"

def read_json(path):
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}

def result_status(task_dir):
    text = (task_dir / "result.md").read_text(encoding="utf-8", errors="replace") if (task_dir / "result.md").is_file() else ""
    m = re.search(r"^STATUS:\s*(\w+)", text, re.I | re.M)
    return m.group(1).lower() if m else ""

def missing_required_markers(task_dir):
    required = ("handoff.md", "pipeline.json", "register.json")
    return [name for name in required if not (task_dir / name).is_file()]

if not tasks_root.is_dir():
    print("No tasks found. Run crew setup first, then use crew run in your host runtime.")
    raise SystemExit(0)

if requested:
    candidates = [tasks_root / requested]
else:
    candidates = [p for p in tasks_root.iterdir() if p.is_dir()]
    def key(path):
        status = result_status(path)
        active = 0 if status == "completed" else 1
        return (active, path.stat().st_mtime)
    candidates.sort(key=key, reverse=True)

task_dir = next((p for p in candidates if p.is_dir()), None)
if task_dir is None:
    print(f"Task not found: {requested}")
    raise SystemExit(2)

if mode == "request":
    missing = missing_required_markers(task_dir)
    if missing:
        print("STATUS: blocked")
        print("BLOCKER: missing_required_state_markers")
        print(f"TASK_DIR: {task_dir}")
        print(f"MISSING: {', '.join(missing)}")
        print("NEXT: Run crew run to create workflow state, or resume from a valid TASK_DIR.")
        raise SystemExit(2)

register = read_json(task_dir / "register.json")
pipeline = read_json(task_dir / "pipeline.json")
status = result_status(task_dir) or register.get("current_phase") or "unknown"
task = register.get("task") or ""
if not task and (task_dir / "task.txt").is_file():
    task = (task_dir / "task.txt").read_text(encoding="utf-8", errors="replace").strip()
handoff = register.get("handoff_path") or str(task_dir / "handoff.md")
completed = pipeline.get("completed_stages", "unknown")
stages = pipeline.get("stages") or []

if mode == "request":
    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    session_id = register.get("session_id") or task_dir.name.rsplit("-", 1)[0]
    trace_id = f"{session_id}.{task_dir.name}.0.0"
    event = {
        "ts": now,
        "trace_id": trace_id,
        "task_id": task_dir.name,
        "session_id": session_id,
        "event": "RESUME_REQUESTED",
        "stage": 0,
        "agent": "",
        "attempt": 0,
        "status": "in_progress",
        "detail": "resume requested via crew resume",
        "files": ["handoff.md"],
    }
    with (task_dir / "progress.buffer.jsonl").open("a", encoding="utf-8") as f:
        f.write(json.dumps(event, ensure_ascii=False, sort_keys=True) + "\n")
    with (task_dir / "progress.log").open("a", encoding="utf-8") as f:
        f.write(f"{now} | RESUME_REQUESTED | resume requested via crew resume\n")

print(f"TASK_ID: {task_dir.name}")
print(f"TASK_DIR: {task_dir}")
print(f"STATUS: {status}")
print(f"STAGES: {completed}/{len(stages) if isinstance(stages, list) else 'unknown'}")
if task:
    print(f"TASK: {task}")
print(f"HANDOFF: {handoff}")
print(f"NEXT: Continue in the host prompt runtime from {handoff}.")
PYEOF
}

cmd_update() {
  local use_local=0
  local all_projects=0
  local source=""
  run_mnemos_update_check() {
    local diagnostics="${ASSET_ROOT}/scripts/crew-diagnostics.py"
    if [ -f "${diagnostics}" ]; then
      python3 "${diagnostics}" \
        --project-root "${PROJECT_ROOT}" \
        --asset-root "${ASSET_ROOT}" \
        --agent-crew-home "${AGENT_CREW_HOME}" \
        config dump --effective --format json 2>/dev/null \
        | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
    mnemos = data.get("mnemos") or {}
except Exception:
    sys.exit(0)
status = mnemos.get("status", "unknown")
detail = mnemos.get("detail", "")
print(f"update_check: mnemos={status} {detail}".rstrip())
' || true
    fi
  }

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h|--help)
      cat <<'EOF'
usage: crew update [--local [SOURCE_ROOT]] [--all-projects]

Default update mode clones origin/main into a fresh temporary checkout and
refreshes the install from that source. Use --local to deterministically refresh
from an existing local checkout.

By default, project-local adapter files are refreshed only for the current
project. Use --all-projects to refresh registered project-local adapter files
after the global install has been updated.
EOF
      return 0
      ;;
      --local)
        use_local=1
        shift
        if [ "$#" -gt 0 ] && [ "${1#-}" = "$1" ]; then
          source="$1"
          shift
          continue
        fi
        continue
        ;;
      --all-projects)
        all_projects=1
        shift
        continue
        ;;
      *)
        die "unknown update argument: $1"
        ;;
    esac
  done

  if [ "${use_local}" = "1" ]; then
      local sync_script="${ASSET_ROOT}/scripts/sync-local-install.sh"
      require_file "${sync_script}" "local sync script"
      bash "${sync_script}" "${source:-${PROJECT_ROOT}}" "${PROJECT_ROOT}"
      if [ "${all_projects}" = "1" ]; then
        update_registered_projects "${source:-${PROJECT_ROOT}}" "${PROJECT_ROOT}"
      fi
      run_mnemos_update_check
      return 0
  fi

  command -v git >/dev/null 2>&1 || die "git is required for native remote update"
  local update_total_start="${SECONDS}"
  local update_phase_start="${SECONDS}"
  local work_dir
  work_dir="$(mktemp -d)"
  git clone --depth 1 https://github.com/woogiekim/agent-crew "${work_dir}"
  printf 'update_phase: remote_clone=%sms\n' "$(( (SECONDS - update_phase_start) * 1000 ))"
  update_phase_start="${SECONDS}"
  local sync_script="${work_dir}/core/scripts/sync-local-install.sh"
  require_file "${sync_script}" "remote local sync script"
  bash "${sync_script}" "${work_dir}" "${PROJECT_ROOT}"
  if [ "${all_projects}" = "1" ]; then
    update_registered_projects "${work_dir}" "${PROJECT_ROOT}"
  fi
  printf 'update_phase: remote_sync=%sms\n' "$(( (SECONDS - update_phase_start) * 1000 ))"
  run_mnemos_update_check
  printf 'update_phase: remote_total=%sms\n' "$(( (SECONDS - update_total_start) * 1000 ))"
}

cmd_run() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew run [--fake-host-result completed] [--host-bridge-command CMD] "task"

Creates deterministic local task state and a supervisor handoff. If no external
host bridge is configured, the run ends as STATUS: handoff_ready after writing
resumable state. Tests may use --fake-host-result completed to exercise the E2E
state path. Hosts may still set AGENT_CREW_HOST_BRIDGE_COMMAND, or pass
--host-bridge-command, to invoke an adapter bridge after handoff creation; a
zero exit status marks the run auto-completed with host bridge evidence.

Common path: run this from the host AI session, follow the printed NEXT line,
then use crew status to monitor or crew repair only if the host handoff had to
be completed manually.
EOF
    return 0
  fi
  print_update_stale_warning
  sync_source_runtime_assets_if_drifted
  require_file "${ASSET_ROOT}/commands/run.md" "run command definition"
  sync_source_hooks_if_drifted
  local runtime="${ASSET_ROOT}/scripts/crew-runtime.py"
  require_file "${runtime}" "native runtime helper"
  python3 "${runtime}" run --project-root "${PROJECT_ROOT}" "$@"
}

cmd_repair() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew repair [--status completed|blocked|cancelled] [--note TEXT] [--evidence PATH]
                   [--quality-evidence PATH] [--quality-bypass-reason TEXT]
                   [--skill-load-evidence PATH] [--skill-load-bypass-reason TEXT]
                   [--skill-use-evidence PATH] [--skill-use-bypass-reason TEXT]
                   [--skill-understanding-evidence PATH]
                   [--skill-understanding-bypass-reason TEXT]
                   [--memory-id ID] TASK_ID

Records the result of a task that was continued manually from handoff.md in the
current host session. This updates local task state so telemetry stops reporting
stale host_bridge_not_invoked blockers after the fallback has completed.
Use --status cancelled when a handoff was intentionally superseded or aborted by
the user before implementation began.
For mutating implementation tasks, completed repairs require full TDD-cycle
evidence (Red, Green, Refactor), reviewer evidence, and skill-load evidence.
Skill-use and skill-understanding notes are optional diagnostic coverage.
Missing or incomplete notes are recorded as advisory gaps rather than completion
blockers when task outcomes, tests, diffs, reviews, or tool events are sufficient.
For read-only validation or documentation-only handoffs, attach the generated
report with --evidence and explain why the quality loop is not applicable with
--quality-bypass-reason.
EOF
    return 0
  fi

  local repair="${ASSET_ROOT}/scripts/repair-task-state.py"
  sync_source_runtime_assets_if_drifted
  require_file "${repair}" "task repair script"
  python3 "${repair}" --state-dir "${STATE_DIR}" "$@"
}

cmd_cancel() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew cancel [--note TEXT] TASK_ID

Marks an intentionally superseded or user-aborted handoff as cancelled. This is
a concise operator-facing wrapper around `crew repair --status cancelled` so
stale handoff-ready work stops appearing as running without being mislabeled as
completed or blocked.
EOF
    return 0
  fi

  local note="cancelled by operator"
  local task_id=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --note)
        [ -n "${2:-}" ] || die "--note requires text"
        note="$2"
        shift 2
        ;;
      *)
        [ -z "${task_id}" ] || die "cancel accepts one TASK_ID"
        task_id="$1"
        shift
        ;;
    esac
  done
  [ -n "${task_id}" ] || die "cancel requires TASK_ID"

  cmd_repair --status cancelled --note "${note}" "${task_id}"
}

cmd_report() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew report auto [--format json|text|none] [--publish github]
       crew report publish [--format json|text|none] [--backend github]
       crew report cleanup [--format json|text|none] [--dry-run]

Stores agent-crew bug/error reports in the native local report outbox. GitHub
publication is an optional backend, not part of the hook contract. Cleanup
quarantines malformed records, internal handoff prompt captures, routine
diagnostic output, and known false-positive Bash reports.
EOF
    return 0
  fi

  local reporter="${ASSET_ROOT}/scripts/auto-issue-reporter.py"
  require_file "${reporter}" "native report script"
  python3 "${reporter}" "$@"
}

cmd_issue_ingest() {
  local runtime="${ASSET_ROOT}/scripts/crew-runtime.py"
  require_file "${runtime}" "crew runtime"
  python3 "${runtime}" issue-ingest --project-root "${PROJECT_ROOT}" "$@"
}

cmd_cleanup_host_bridge() {
  local helper="${ASSET_ROOT}/scripts/crew-cli-cleanup.sh"
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    require_file "${helper}" "cleanup command helper"
    ASSET_ROOT="${ASSET_ROOT}" STATE_DIR="${STATE_DIR}" bash "${helper}" cleanup-host-bridge "$@"
    return
  fi
  sync_source_runtime_assets_if_drifted
  require_file "${helper}" "cleanup command helper"
  ASSET_ROOT="${ASSET_ROOT}" STATE_DIR="${STATE_DIR}" bash "${helper}" cleanup-host-bridge "$@"
}

cmd_cleanup_state() {
  local helper="${ASSET_ROOT}/scripts/crew-cli-cleanup.sh"
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    require_file "${helper}" "cleanup command helper"
    ASSET_ROOT="${ASSET_ROOT}" STATE_DIR="${STATE_DIR}" bash "${helper}" cleanup-state "$@"
    return
  fi
  sync_source_runtime_assets_if_drifted
  require_file "${helper}" "cleanup command helper"
  ASSET_ROOT="${ASSET_ROOT}" STATE_DIR="${STATE_DIR}" bash "${helper}" cleanup-state "$@"
}

cmd_agent() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<'EOF'
usage: crew agent [--host-bridge-command CMD] [agent-name] [question]

Validates the direct-agent request and writes deterministic host handoff state.
The host prompt runtime still performs the actual read-only analysis.
Hosts may set AGENT_CREW_HOST_BRIDGE_COMMAND, or pass --host-bridge-command,
to execute a configured adapter bridge command after handoff creation.
If the bridge returns zero, command output is marked auto-completed.
EOF
    return 0
  fi
  require_file "${ASSET_ROOT}/commands/agent.md" "agent command definition"
  local runtime="${ASSET_ROOT}/scripts/crew-runtime.py"
  require_file "${runtime}" "native runtime helper"
  python3 "${runtime}" agent --project-root "${PROJECT_ROOT}" --asset-root "${ASSET_ROOT}" "$@"
}

main() {
  local command="${1:-help}"
  [ "$#" -gt 0 ] && shift || true

  case "${command}" in
    setup) cmd_setup "$@" ;;
    status) cmd_status "$@" ;;
    telemetry) cmd_telemetry "$@" ;;
    trace) cmd_trace "$@" ;;
    cost) cmd_cost "$@" ;;
    doctor) cmd_doctor "$@" ;;
    config) cmd_config "$@" ;;
    debug) cmd_debug "$@" ;;
    readiness) cmd_readiness "$@" ;;
    question) cmd_question "$@" ;;
    resume) cmd_resume "$@" ;;
    update) cmd_update "$@" ;;
    run) cmd_run "$@" ;;
    report) cmd_report "$@" ;;
    issue-ingest) cmd_issue_ingest "$@" ;;
    cancel) cmd_cancel "$@" ;;
    repair) cmd_repair "$@" ;;
    cleanup-host-bridge) cmd_cleanup_host_bridge "$@" ;;
    cleanup-state) cmd_cleanup_state "$@" ;;
    agent) cmd_agent "$@" ;;
    help|-h|--help) usage ;;
    *) die "unknown command: ${command}" ;;
  esac
}

main "$@"
