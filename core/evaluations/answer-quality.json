{
  "schema_version": 1,
  "name": "agent-crew report answer-quality regression",
  "required_sections": [
    "MEASUREMENTS",
    "EVIDENCE",
    "UNCERTAINTY"
  ],
  "allowed_blockers": [
    "host_bridge_not_invoked",
    "stale_host_bridge_not_invoked",
    "supervisor_handoff_not_started",
    "stage_timeout",
    "quality_loop_exhausted",
    "cost_exceeded",
    "manual_fallback_blocked",
    "cancelled"
  ],
  "memory_context_path": "context/memory.md",
  "canonical_context_path": "context/canonical-context.md",
  "memory_evidence_trace_path": "context/memory-evidence.json",
  "require_memory_evidence_trace_when_context_available": true
}
